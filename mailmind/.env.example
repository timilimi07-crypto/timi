# ---------------------------------------------------------------------------
# MailMind – Umgebungsvariablen
# Kopieren: cp .env.example .env   und Werte anpassen.
# ---------------------------------------------------------------------------

# --- Datenbank & Queue ---
DATABASE_URL="postgresql://mailmind:mailmind@localhost:5432/mailmind?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Auth (NextAuth) ---
NEXTAUTH_URL="http://localhost:3000"
# Erzeugen mit: openssl rand -base64 32
NEXTAUTH_SECRET="bitte-aendern-mindestens-32-zeichen-lang"

# --- Verschlüsselung der Postfach-Zugangsdaten (AES-256-GCM) ---
# 32 Byte, base64. Erzeugen mit: openssl rand -base64 32
# ACHTUNG: Geht der Schlüssel verloren, müssen alle Postfächer neu verbunden werden.
ENCRYPTION_KEY="bitte-mit-openssl-rand-base64-32-erzeugen"

# --- KI (Anthropic Claude) ---
ANTHROPIC_API_KEY=""
# Hauptmodell: Zusammenfassung, Priorität, Aufgaben, Antwortvorschläge.
#   claude-sonnet-5-5 (Standard, empfohlen) oder claude-opus-5-5 (höchste Qualität, ca. 2× Kosten)
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Schnelles Modell für einfache Aufgaben (Spam/Newsletter erkennen, Kategorie).
#   claude-haiku-5-5 (Standard) oder claude-sonnet-5-5
ANTHROPIC_MODEL_FAST="claude-haiku-5-5"
# Beide Werte lassen sich pro Firma unter Einstellungen → Allgemein überschreiben.

# --- Demo-Modus: Seed-Daten + Demo-Postfächer ohne echtes Postfach ---
DEMO_MODE="true"

# --- Versand (Tages-Digest), z. B. smtp://user:pass@smtp.example.com:587 ---
SMTP_URL=""
MAIL_FROM="MailMind <no-reply@example.com>"

# --- Gmail-Anbindung (Google Cloud Console → OAuth-Client) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Outlook/Exchange-Anbindung (Azure Portal → App-Registrierung) ---
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
