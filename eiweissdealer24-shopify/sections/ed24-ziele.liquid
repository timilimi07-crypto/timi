{%- comment -%}
  ED24 Ziele – Eiweissdealer24
  „Was ist dein Ziel?“: große Kacheln, die direkt in die passende Kollektion führen.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Barlow:wght@400;500;600;700&display=swap">

<div class="ed24-goals" style="background-color: {{ section.settings.background }}; --ed24-accent: {{ section.settings.accent }};">
  <div class="ed24-goals__wrap">
    {%- if section.settings.eyebrow != blank -%}<p class="ed24-goals__eye">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="ed24-goals__title">{{ section.settings.title | escape }}</h2>
    <div class="ed24-goals__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign href = block.settings.link
          if c != blank
            assign href = c.url
          endif
          if href == blank
            assign href = routes.all_products_collection_url
          endif
        -%}
        <a class="ed24-goal" href="{{ href }}" {{ block.shopify_attributes }}>
          <span class="ed24-goal__num">
            {%- if forloop.index < 10 %}0{% endif %}{{ forloop.index -}}
            {%- if c != blank %} · {{ c.products_count }} {% if c.products_count == 1 %}Produkt{% else %}Produkte{% endif %}{% endif -%}
          </span>
          <span class="ed24-goal__body">
            <span class="ed24-goal__h">{{ block.settings.title | escape }}</span>
            {%- if block.settings.text != blank -%}<span class="ed24-goal__t">{{ block.settings.text | escape }}</span>{%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
    {%- assign ed24_oh = section.settings.offers_collection | default: 'angebote' -%}{%- assign ed24_oc = collections[ed24_oh] -%}{%- assign ed24_ot = section.settings.offers_title | default: 'Aktuelle Angebote' -%}
    {%- if section.settings.show_offers != false and ed24_oc.products_count > 0 -%}
      <div class="ed24-offers">
        <div class="ed24-offers__head">
          <h3 class="ed24-offers__title">{{ ed24_ot | escape }}</h3>
          <a class="ed24-offers__all" href="{{ ed24_oc.url }}">Alle {{ ed24_oc.products_count }} ansehen →</a>
        </div>
        <div class="ed24-offers__row">
          {%- for p in ed24_oc.products limit: 8 -%}
            <a class="ed24-offer" href="{{ p.url }}">
              <span class="ed24-offer__img">
                {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: p.title, widths: '250,500', sizes: '(min-width: 990px) 260px, 45vw' }}{%- endif -%}
                {%- if p.compare_at_price > p.price -%}<em class="ed24-offer__tag">-{{ p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price }} %</em>{%- endif -%}
              </span>
              <span class="ed24-offer__v">{{ p.vendor | escape }}</span>
              <span class="ed24-offer__t">{{ p.title | escape }}</span>
              <span class="ed24-offer__p">{%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s> {% endif -%}<b>{{ p.price | money }}</b></span>
            </a>
          {%- endfor -%}
        </div>
      </div>
      <style>
        .ed24-offers{margin-top:clamp(40px,6vw,64px)}
        .ed24-offers__head{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:16px}
        .ed24-goals .ed24-offers__title{margin:0;font-family:'Barlow Condensed',sans-serif;font-weight:800;font-style:italic;text-transform:uppercase;font-size:clamp(28px,4vw,44px);line-height:.95;color:#f5f5f4}
        .ed24-goals .ed24-offers__all{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:15px;letter-spacing:.05em;text-transform:uppercase;color:var(--ed24-accent,#e30613);text-decoration:none}
        .ed24-offers__row{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(160px,44%);gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:8px;-webkit-overflow-scrolling:touch;scrollbar-width:thin}
        .ed24-offer{scroll-snap-align:start;display:flex;flex-direction:column;gap:4px;color:#f5f5f4;text-decoration:none}
        .ed24-offer__img{position:relative;display:block;aspect-ratio:1;border-radius:14px;overflow:hidden;background:#131315;margin-bottom:6px}
        .ed24-offer__img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s}
        .ed24-offer:hover .ed24-offer__img img{transform:scale(1.05)}
        .ed24-offer__tag{position:absolute;left:10px;top:10px;padding:4px 9px;border-radius:999px;background:var(--ed24-accent,#e30613);color:#fff;font-style:normal;font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:14px}
        .ed24-offer__v{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--ed24-accent,#e30613)}
        .ed24-offer__t{font-family:'Barlow',sans-serif;font-size:14px;line-height:1.3}
        .ed24-offer__p{font-family:'Barlow',sans-serif;font-size:14px}
        .ed24-offer__p s{color:#8a8a92;margin-right:4px}
        @media (min-width:750px){.ed24-offers__row{grid-auto-columns:minmax(200px,30%)}}
        @media (min-width:990px){.ed24-offers__row{grid-auto-flow:row;grid-template-columns:repeat(4,minmax(0,1fr));overflow:visible}}
      </style>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ed24-goals{padding:clamp(56px,9vw,104px) 0;color:#f5f5f4}
  .ed24-goals__wrap{max-width:1280px;margin:0 auto;padding:0 clamp(16px,3vw,28px)}
  .ed24-goals .ed24-goals__eye{display:flex;align-items:center;gap:10px;margin:0 0 14px;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-style:normal;text-transform:uppercase;letter-spacing:.14em;font-size:13px;color:var(--ed24-accent,#e30613)}
  .ed24-goals .ed24-goals__eye::before{content:"";width:28px;height:3px;background:var(--ed24-accent,#e30613);transform:skewX(-20deg)}
  .ed24-goals .ed24-goals__title{margin:0 0 26px;font-family:'Barlow Condensed',sans-serif;font-weight:800;font-style:italic;text-transform:uppercase;font-size:clamp(36px,5.6vw,62px);line-height:.92;letter-spacing:.005em;color:#f5f5f4}
  .ed24-goals__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .ed24-goal{border-radius:14px;background:#131315;border:1px solid #2c2c32;padding:18px;min-height:140px;display:flex;flex-direction:column;justify-content:space-between;gap:12px;color:#f5f5f4;text-decoration:none;transition:border-color .2s,transform .2s}
  .ed24-goal:hover{border-color:var(--ed24-accent,#e30613);transform:translateY(-3px)}
  .ed24-goal:first-child{grid-column:span 2;background:linear-gradient(135deg,var(--ed24-accent,#e30613),#8d040c);border-color:transparent}
  .ed24-goal__num{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-style:italic;font-size:15px;color:#7a7a82}
  .ed24-goal:first-child .ed24-goal__num,.ed24-goal:first-child .ed24-goal__t{color:#ffd6d8}
  .ed24-goal__h{display:block;font-family:'Barlow Condensed',sans-serif;font-weight:800;font-style:italic;text-transform:uppercase;font-size:28px;line-height:.92}
  .ed24-goal__t{display:block;margin-top:6px;font-family:'Barlow',sans-serif;font-size:13px;color:#a6a6ad}
  @media (min-width:990px){
    .ed24-goals__grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:14px}
    .ed24-goal{min-height:190px;padding:22px}
    .ed24-goal:first-child{grid-column:auto}
    .ed24-goal__h{font-size:32px}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ED24 Ziele",
  "tag": "section",
  "class": "ed24-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift", "default": "Finde schneller, was du brauchst" },
    { "type": "text", "id": "title", "label": "Überschrift", "default": "Was ist dein Ziel?" },
    { "type": "header", "content": "Angebote-Reihe" },
    { "type": "checkbox", "id": "show_offers", "label": "Angebote unter den Zielen zeigen", "default": true },
    { "type": "text", "id": "offers_title", "label": "Überschrift Angebote", "default": "Aktuelle Angebote" },
    { "type": "text", "id": "offers_collection", "label": "Kollektion (Handle)", "default": "angebote" },
    { "type": "color", "id": "background", "label": "Hintergrund", "default": "#0a0a0b" },
    { "type": "color", "id": "accent", "label": "Markenfarbe", "default": "#e30613" }
  ],
  "blocks": [
    {
      "type": "goal",
      "name": "Ziel",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Muskelaufbau" },
        { "type": "text", "id": "text", "label": "Text", "default": "Protein · Whey · Isolat" },
        { "type": "collection", "id": "collection", "label": "Kollektion", "info": "Die Produktanzahl wird automatisch angezeigt." },
        { "type": "url", "id": "link", "label": "Oder eigener Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ED24 Ziele",
      "blocks": [
        { "type": "goal", "settings": { "title": "Muskelaufbau", "text": "Protein · Whey · Isolat" } },
        { "type": "goal", "settings": { "title": "Definition", "text": "Burner · Low Carb · Clear" } },
        { "type": "goal", "settings": { "title": "Pump & Power", "text": "Booster · Pump · Fokus" } },
        { "type": "goal", "settings": { "title": "Gesundheit", "text": "Vitamine · Omega 3 · Magnesium" } },
        { "type": "goal", "settings": { "title": "Kampfsport", "text": "Handschuhe · Bandagen · Shorts" } }
      ]
    }
  ]
}
{% endschema %}
