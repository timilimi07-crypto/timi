{%- comment -%}
  ED24 Coaching-Panel – Eiweissdealer24
  Dunkles Panel, das sich beim Scrollen von einer Karte zur vollen Fläche aufzieht.
  Unter „ED24 Story“ platzieren. Danach endet die 3D-Bühne.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Righteous&family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Barlow:wght@400;500;600;700&display=swap">

{%- liquid
  assign phone_link = section.settings.phone | remove: ' ' | remove: '–' | remove: '-' | remove: '/' | remove: '(' | remove: ')'
-%}
<div class="ed24-coach" data-ed24-coach style="--ed24-accent: {{ section.settings.accent }};">
  <div class="ed24-coach__sticky">
    <ed24-coach class="ed24-coach__panel" style="background-color: {{ section.settings.background }};">
      <div class="ed24-coach__ghost" data-ed24-ghost aria-hidden="true">{{ section.settings.ghost | escape }}</div>
      <div class="ed24-coach__inner" data-ed24-inner>
        {%- if section.settings.eyebrow != blank -%}<p class="ed24-coach__eye">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="ed24-coach__title">
          {{- section.settings.title_1 | escape -}}
          {%- if section.settings.title_2 != blank -%}<br><em>{{ section.settings.title_2 | escape }}</em>{%- endif -%}
        </h2>
        {%- if section.settings.text != blank -%}<p class="ed24-coach__lead">{{ section.settings.text | escape }}</p>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <div class="ed24-coach__svcs">
            {%- for block in section.blocks -%}
              <div class="ed24-coach__svc" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
                <span class="ed24-coach__no">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
                <strong>{{ block.settings.title | escape }}</strong>
                <span class="ed24-coach__svctext">{{ block.settings.text | escape }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div class="ed24-coach__ctas">
          {%- if section.settings.button_label != blank -%}
            <a class="ed24-coach__btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
              {{- section.settings.button_label | escape -}}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <a class="ed24-coach__btn ed24-coach__btn--line" href="tel:{{ phone_link }}">{{ section.settings.phone | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    </ed24-coach>
  </div>
</div>

{% stylesheet %}
  .ed24-coach{position:relative;z-index:2;height:250vh;height:250svh}
  .ed24-coach__sticky{position:sticky;top:0;height:100vh;height:100svh}
  .ed24-coach__panel{position:absolute;inset:0;display:block;overflow:hidden;color:#fff;border-radius:28px;transform:scale(.7);will-change:transform;background-image:radial-gradient(ellipse 60% 55% at 80% 20%,rgba(227,6,19,.4),transparent 70%)}
  .ed24-coach__panel.is-flush{border-radius:0}
  .ed24-coach__ghost{position:absolute;top:50%;left:0;white-space:nowrap;font-family:'Righteous',sans-serif;font-weight:400;font-style:normal;font-size:24vw;line-height:.9;text-transform:uppercase;color:transparent;-webkit-text-stroke:1.5px rgba(255,255,255,.08);transform:translateY(-50%);will-change:transform;pointer-events:none}
  .ed24-coach__inner{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;padding:0 clamp(16px,5vw,80px);will-change:transform}
  .ed24-coach .ed24-coach__eye{margin:0 0 14px;font-family:'Righteous',sans-serif;font-weight:400;font-style:normal;letter-spacing:.16em;text-transform:uppercase;font-size:12px;color:var(--ed24-accent,#e30613)}
  .ed24-coach .ed24-coach__title{margin:0;font-family:'Righteous',sans-serif;font-weight:400;font-style:normal;text-transform:uppercase;font-size:clamp(39px,6.75vw,120px);line-height:.9;letter-spacing:.005em;color:#fff}
  .ed24-coach .ed24-coach__title em{font-style:italic;color:var(--ed24-accent,#e30613)}
  .ed24-coach .ed24-coach__lead{max-width:520px;margin:22px 0 0;font-family:'Barlow',sans-serif;font-size:18px;line-height:1.5;color:#d4d4d8}
  .ed24-coach__svcs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:5vh}
  .ed24-coach__svc{padding:20px;border:1px solid rgba(255,255,255,.14);border-radius:18px;background:rgba(255,255,255,.03);font-family:'Barlow',sans-serif;font-size:14px;color:#a6a6ad;opacity:0;transform:translateY(30px);transition:opacity .8s cubic-bezier(.2,.8,.2,1),transform .8s cubic-bezier(.2,.8,.2,1);transition-delay:calc(var(--i,0) * 90ms)}
  .ed24-coach__svc strong{display:block;margin-bottom:8px;overflow-wrap:anywhere;-webkit-hyphens:auto;hyphens:auto;font-family:'Righteous',sans-serif;font-weight:400;font-style:normal;text-transform:uppercase;font-size:20px;line-height:1;color:#fff}
  .ed24-coach__no{display:block;margin-bottom:20px;font-family:'Righteous',sans-serif;font-weight:400;color:var(--ed24-accent,#e30613);letter-spacing:.1em}
  .ed24-coach__panel.is-full .ed24-coach__svc{opacity:1;transform:none}
  .ed24-coach__ctas{display:flex;flex-wrap:wrap;gap:10px;margin-top:4vh;opacity:0;transition:opacity .8s .4s}
  .ed24-coach__panel.is-full .ed24-coach__ctas{opacity:1}
  .ed24-coach .ed24-coach__btn{display:inline-flex;align-items:center;gap:10px;min-height:52px;padding:0 26px;border-radius:999px;background:var(--ed24-accent,#e30613);color:#fff;font-family:'Righteous',sans-serif;font-weight:400;font-size:17px;text-transform:uppercase;letter-spacing:.04em;text-decoration:none;border:1.5px solid transparent;transition:transform .15s}
  .ed24-coach .ed24-coach__btn:active{transform:scale(.97)}
  .ed24-coach .ed24-coach__btn--line{background:transparent;border-color:rgba(255,255,255,.35)}
  @media (max-width:900px){
    .ed24-coach__svcs{grid-template-columns:repeat(2,minmax(0,1fr))}
    .ed24-coach__svc{padding:14px}
    .ed24-coach__svc strong{font-size:20px}
    .ed24-coach__svctext{display:none}
    .ed24-coach__no{margin-bottom:8px}
  }
  @media (max-width:749px){
    .ed24-coach__inner{justify-content:flex-start;padding-top:92px}
    .ed24-coach .ed24-coach__title{font-size:9.4vw}
    .ed24-coach .ed24-coach__lead{font-size:15px;margin-top:14px}
    .ed24-coach .ed24-coach__btn{min-height:46px;font-size:16px}
  }
{% endstylesheet %}

{% javascript %}
  // Coaching-Panel: zieht sich beim Scrollen auf volle Fläche auf (nur transform, daher flüssig).
  var ed24CoachClamp = function (v) { return Math.min(1, Math.max(0, v)); };
  // Feste Bildschirmhöhe (100svh): bleibt gleich, wenn Safari beim Scrollen die Adressleiste ein- oder ausblendet.
  if (!window.ed24Vh) {
    window.ed24Vh = (function () {
      var probe, v = 0;
      window.addEventListener('resize', function () { v = 0; }, { passive: true });
      return function () {
        if (!v) {
          if (!probe) {
            probe = document.createElement('div');
            probe.setAttribute('aria-hidden', 'true');
            probe.style.cssText = 'position:fixed;left:0;top:0;width:0;height:100vh;height:100svh;visibility:hidden;pointer-events:none';
            (document.body || document.documentElement).appendChild(probe);
          }
          v = probe.offsetHeight || window.innerHeight;
        }
        return v;
      };
    })();
  }
  class Ed24Coach extends HTMLElement {
    connectedCallback() {
      var self = this;
      this.ctrl = new AbortController();
      var opts = { signal: this.ctrl.signal, passive: true };
      this.section = this.closest('[data-ed24-coach]') || this;
      this.inner = this.querySelector('[data-ed24-inner]');
      this.ghost = this.querySelector('[data-ed24-ghost]');
      this.still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var queue = function () {
        if (self.tick) return;
        self.tick = requestAnimationFrame(function () { self.tick = 0; self.update(); });
      };
      window.addEventListener('scroll', queue, opts);
      window.addEventListener('resize', queue, opts);
      this.update();
    }

    disconnectedCallback() {
      if (this.ctrl) this.ctrl.abort();
      cancelAnimationFrame(this.tick);
      this.tick = 0;
    }

    update() {
      var r = this.section.getBoundingClientRect(), vh = window.ed24Vh();
      if (r.bottom < 0 || r.top > vh) return;
      var t = ed24CoachClamp((-r.top + vh * 0.25) / (vh * 1.05));
      var p = this.still ? 1 : 1 - Math.pow(1 - t, 3);
      var from = window.innerWidth < 750 ? 0.88 : 0.7;
      this.style.transform = 'scale(' + (from + (1 - from) * p) + ')';
      this.classList.toggle('is-flush', p > 0.995);
      this.classList.toggle('is-full', p > 0.82);
      if (this.inner) this.inner.style.transform = 'translate3d(0,' + (1 - p) * 60 + 'px,0)';
      if (this.ghost) this.ghost.style.transform = 'translate3d(' + r.top * 0.35 + 'px,-50%,0)';
    }
  }
  if (!customElements.get('ed24-coach')) customElements.define('ed24-coach', Ed24Coach);
{% endjavascript %}

{% schema %}
{
  "name": "ED24 Coaching-Panel",
  "tag": "section",
  "class": "ed24-section",
  "max_blocks": 4,
  "settings": [
    { "type": "paragraph", "content": "Unter „ED24 Story“ platzieren." },
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift", "default": "Ernährungs- & Trainingscoaching" },
    { "type": "text", "id": "title_1", "label": "Titel Zeile 1", "default": "Kein Plan?" },
    { "type": "text", "id": "title_2", "label": "Titel Zeile 2 (rot)", "default": "Wir schreiben dir einen." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Individuell für deinen Alltag – ob Schichtarbeit, vegan, Leistungssport oder einfach gesünder leben. Und wir bleiben dein Ansprechpartner." },
    { "type": "text", "id": "ghost", "label": "Hintergrund-Schriftzug", "default": "Coaching · Coaching · Coaching ·" },
    { "type": "text", "id": "button_label", "label": "Button-Text", "default": "Coaching ansehen" },
    { "type": "url", "id": "button_link", "label": "Button-Link", "info": "Zum Beispiel die Kollektion „Coaching“." },
    { "type": "text", "id": "phone", "label": "Telefonnummer", "default": "0381 – 203 38 71" },
    { "type": "color", "id": "background", "label": "Hintergrund", "default": "#0b0b0c" },
    { "type": "color", "id": "accent", "label": "Markenfarbe", "default": "#e30613" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Leistung",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Ernährungs- & Trainingsplan" },
        { "type": "text", "id": "text", "label": "Text", "default": "Nach Maß, ohne Hungern." }
      ]
    }
  ],
  "presets": [
    {
      "name": "ED24 Coaching-Panel",
      "blocks": [
        { "type": "service", "settings": { "title": "Ernährungs- & Trainingsplan", "text": "Nach Maß, ohne Hungern." } },
        { "type": "service", "settings": { "title": "Personal- & Posingtraining", "text": "1:1 mit uns in Rostock." } },
        { "type": "service", "settings": { "title": "Fettmessung", "text": "Fortschritt sichtbar machen." } },
        { "type": "service", "settings": { "title": "Wettkampfvorbereitung", "text": "Seit 2016 auf der Bühne." } }
      ]
    }
  ]
}
{% endschema %}
