{%- comment -%}
  ED24 Laufschrift – Eiweissdealer24
  Riesige Laufschrift (wird beim Scrollen schneller) mit zwei Stickern: E-Mail und Telefon.
  Ideal als letzter Abschnitt über dem Footer.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Righteous&family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Barlow:wght@400;500;600;700&display=swap">

{%- liquid
  assign s = section.settings
  assign phone_link = s.phone | remove: ' ' | remove: '–' | remove: '-' | remove: '/' | remove: '(' | remove: ')'
-%}
<div class="ed24-mq" style="background-color: {{ s.background }}; --ed24-accent: {{ s.accent }};">
  <ed24-marquee class="ed24-mq__band" role="img" aria-label="{{ s.text | escape }}">
    <div class="ed24-mq__track" data-ed24-track aria-hidden="true">
      {%- for i in (1..4) -%}<span>{{ s.text | escape }} ✦</span>{%- endfor -%}
    </div>
  </ed24-marquee>
  {%- if s.email != blank and s.sticker_1 != blank -%}
    <a class="ed24-mq__sticker ed24-mq__sticker--1" href="mailto:{{ s.email | escape }}">{{ s.sticker_1 | escape | replace: ' ', '<br>' }}</a>
  {%- endif -%}
  {%- if s.phone != blank and s.sticker_2 != blank -%}
    <a class="ed24-mq__sticker ed24-mq__sticker--2" href="tel:{{ phone_link }}">{{ s.sticker_2 | escape | replace: ' ', '<br>' }}</a>
  {%- endif -%}
  {%- if s.note != blank -%}
    <div class="ed24-mq__foot"><p class="ed24-mq__note">{{ s.note | escape }}</p></div>
  {%- endif -%}
</div>

{% stylesheet %}
  .ed24-mq{position:relative;overflow:hidden;padding-top:6vh;color:#111}
  .ed24-mq__band{display:block;white-space:nowrap;padding:2vh 0;font-family:'Righteous',sans-serif;font-weight:400;font-style:normal;text-transform:uppercase;font-size:clamp(67.5px,12.75vw,225px);line-height:.95;color:var(--ed24-accent,#e30613)}
  .ed24-mq__track{display:inline-flex;will-change:transform}
  .ed24-mq__track span{padding-right:.35em}
  .ed24-mq .ed24-mq__sticker{position:absolute;z-index:2;display:flex;align-items:center;justify-content:center;padding:18px 26px;border-radius:50%;background:var(--ed24-accent,#e30613);color:#fff;font-family:'Righteous',sans-serif;font-weight:400;text-transform:uppercase;font-size:clamp(12px,1.1vw,16px);letter-spacing:.06em;text-align:center;line-height:1.05;text-decoration:none;box-shadow:0 14px 30px -12px rgba(0,0,0,.4);transition:transform .3s cubic-bezier(.2,.8,.2,1)}
  .ed24-mq .ed24-mq__sticker--1{left:4vw;top:12%;transform:rotate(-12deg)}
  .ed24-mq .ed24-mq__sticker--2{right:6vw;bottom:30%;transform:rotate(10deg)}
  .ed24-mq .ed24-mq__sticker:hover{transform:rotate(0) scale(1.08)}
  .ed24-mq__foot{padding:10vh clamp(16px,4vw,64px) 22px;text-align:center;background:linear-gradient(180deg,transparent,rgba(227,6,19,.35) 20%,var(--ed24-accent,#e30613) 70%)}
  .ed24-mq .ed24-mq__note{margin:0;font-family:'Barlow',sans-serif;font-size:12px;color:rgba(255,255,255,.85)}
{% endstylesheet %}

{% javascript %}
  // Laufschrift: läuft dauerhaft und wird mit der Scroll-Geschwindigkeit schneller.
  class Ed24Marquee extends HTMLElement {
    connectedCallback() {
      var self = this;
      this.track = this.querySelector('[data-ed24-track]');
      if (!this.track || window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
      this.x = 0;
      this.lastY = window.scrollY;
      this.last = performance.now();
      this.observer = new IntersectionObserver(function (entries) {
        cancelAnimationFrame(self.raf);
        if (entries[0].isIntersecting) {
          self.half = self.track.scrollWidth / 2 || 1;
          self.last = performance.now();
          self.raf = requestAnimationFrame(function (t) { self.frame(t); });
        }
      });
      this.observer.observe(this);
    }

    disconnectedCallback() {
      if (this.observer) this.observer.disconnect();
      cancelAnimationFrame(this.raf);
    }

    frame(now) {
      var self = this;
      this.raf = requestAnimationFrame(function (t) { self.frame(t); });
      var dt = Math.min(0.05, (now - this.last) / 1000);
      this.last = now;
      var v = Math.abs(window.scrollY - this.lastY) / Math.max(dt, 0.001);
      this.lastY = window.scrollY;
      this.x = (this.x + (40 + Math.min(v, 4000) * 0.08) * dt) % this.half;
      this.track.style.transform = 'translate3d(' + -this.x + 'px,0,0)';
    }
  }
  if (!customElements.get('ed24-marquee')) customElements.define('ed24-marquee', Ed24Marquee);
{% endjavascript %}

{% schema %}
{
  "name": "ED24 Laufschrift",
  "tag": "section",
  "class": "ed24-section",
  "settings": [
    { "type": "text", "id": "text", "label": "Laufschrift", "default": "info@eiweissdealer24.de" },
    { "type": "text", "id": "email", "label": "E-Mail für Sticker 1", "default": "info@eiweissdealer24.de" },
    { "type": "text", "id": "sticker_1", "label": "Sticker 1", "default": "Schreib uns" },
    { "type": "text", "id": "phone", "label": "Telefon für Sticker 2", "default": "0381 – 203 38 71" },
    { "type": "text", "id": "sticker_2", "label": "Sticker 2", "default": "Ruf an" },
    { "type": "text", "id": "note", "label": "Text im roten Streifen", "default": "Eiweissdealer24 · Supplements & Coaching aus Rostock · seit 2007" },
    { "type": "color", "id": "background", "label": "Hintergrund", "default": "#efece6" },
    { "type": "color", "id": "accent", "label": "Markenfarbe", "default": "#e30613" }
  ],
  "presets": [{ "name": "ED24 Laufschrift" }]
}
{% endschema %}
