{%- comment -%}
  ED24 Topbar – Eiweissdealer24
  Rote Infoleiste ganz oben (Laden, Überraschung ab 100 €, Beratung) und die Markenschriften für den ganzen Shop.
  In die Kopfzeile (Header-Bereich) einfügen, damit sie auf jeder Seite erscheint.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Barlow:wght@400;500;600;700&display=swap">

{%- liquid
  assign s = section.settings
  assign phone_link = s.phone | remove: ' ' | remove: '–' | remove: '-' | remove: '/' | remove: '(' | remove: ')'
-%}
{%- if s.brand_fonts -%}
  <style>
    /* Markenschriften im ganzen Shop: Texte, Menü, Preise und Buttons in Barlow, Überschriften in Barlow Condensed. */
    html:root {
      --font-body--family: 'Barlow', sans-serif;
      --font-body--style: normal;
      --font-body--weight: 500;
      --font-subheading--family: 'Barlow', sans-serif;
      --font-subheading--style: normal;
      --font-subheading--weight: 600;
      --font-heading--family: 'Barlow Condensed', sans-serif;
      --font-heading--style: italic;
      --font-heading--weight: 800;
      --font-accent--family: 'Barlow Condensed', sans-serif;
      --font-accent--style: normal;
      --font-accent--weight: 700;
    }
    h1, h2, .h0, .h1, .h2 {
      font-family: 'Barlow Condensed', sans-serif !important;
      font-weight: 800 !important;
      font-style: italic;
      text-transform: uppercase;
      letter-spacing: .005em;
    }
    /* Produkt-Menü wie im Original-Shop: Kategorien fett, Unterkategorien darunter, in Spalten */
    .mega-menu .mega-menu__link--parent,
    .mega-menu .mega-menu__list:has(.mega-menu__link--parent) .mega-menu__column > div > .mega-menu__link {
      position: relative;
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 17px;
      line-height: 1.1;
      letter-spacing: .02em;
      text-transform: uppercase;
      color: #fff;
      padding: 0 0 8px;
      margin-bottom: 6px;
    }
    .mega-menu .mega-menu__link--parent::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: 0;
      width: 24px;
      height: 2px;
      background: {{ s.accent }};
      transition: width .3s cubic-bezier(.2,.8,.2,1);
    }
    .mega-menu .mega-menu__link--parent:hover::after { width: 100%; }
    .mega-menu .mega-menu__list:has(.mega-menu__link--parent) .mega-menu__column > div + div { margin-top: 10px; }
    .mega-menu .mega-menu__column ul .mega-menu__link {
      font-family: 'Barlow', sans-serif;
      font-style: normal;
      font-weight: 500;
      font-size: 14px;
      text-transform: none;
      color: #b4b4ba;
      padding: 3px 0;
      transition: color .2s, transform .25s cubic-bezier(.2,.8,.2,1);
    }
    .mega-menu .mega-menu__column ul .mega-menu__link:hover { color: #fff; transform: translateX(4px); }
    /* „Mein Konto“ neben dem Personen-Symbol (Anmelden und Registrieren), wie im bisherigen Shop */
    @media (min-width: 990px) {
      .account-button .account-button__text.hidden { display: inline !important; margin-right: 6px; font-weight: 600; font-size: 14px; }
      .account-button .account-button__text::before { content: "Mein "; }
    }
  </style>
{%- endif -%}
{%- if s.effects -%}
  <div class="ed24-progress" aria-hidden="true"></div>
  <style>
    /* Effekte im ganzen Shop: nur transform, opacity und Farben, damit es auch auf iPad und Handy flüssig bleibt. */
    .ed24-progress{position:fixed;left:0;top:0;width:100%;height:3px;background:linear-gradient(90deg,{{ s.accent }},#ff5a00);transform-origin:0 50%;transform:scaleX(0);z-index:40;pointer-events:none}
    ::selection{background:{{ s.accent }};color:#fff}
    html{scrollbar-color:{{ s.accent }} #0b0b0c}
    product-card.product-card .card-gallery{border-radius:12px;overflow:hidden}
    product-card.product-card .card-gallery img{transition:transform .6s cubic-bezier(.2,.8,.2,1),filter .4s}
    @media (hover:hover){
      product-card.product-card{border-radius:14px;transition:box-shadow .35s,background-color .35s}
      product-card.product-card:hover{box-shadow:0 24px 48px -24px rgba(227,6,19,.7),0 0 0 1px rgba(227,6,19,.4);background-color:#121214}
      product-card.product-card:hover .card-gallery img{transform:scale(1.07);filter:brightness(1.08)}
    }
    .ed24-rv{opacity:0;transform:translateY(28px)}
    .ed24-rv.is-in{opacity:1;transform:none;transition:opacity .7s cubic-bezier(.2,.8,.2,1),transform .7s cubic-bezier(.2,.8,.2,1);transition-delay:calc(var(--ed24-d,0) * 70ms)}
    .menu-list__link-title{position:relative}
    .menu-list__link-title::after{content:"";position:absolute;left:0;right:0;bottom:-6px;height:2px;background:{{ s.accent }};transform:scaleX(0);transform-origin:100% 50%;transition:transform .35s cubic-bezier(.2,.8,.2,1)}
    .menu-list__link:hover .menu-list__link-title::after,.menu-list__link--active .menu-list__link-title::after{transform:scaleX(1);transform-origin:0 50%}
    .button:not(.button-unstyled):not(.button-secondary){background-image:linear-gradient(110deg,transparent 38%,rgba(255,255,255,.32) 50%,transparent 62%);background-size:260% 100%;background-position:130% 0;background-repeat:no-repeat;transition:background-position .8s cubic-bezier(.2,.8,.2,1),transform .2s}
    @media (hover:hover){.button:not(.button-unstyled):not(.button-secondary):hover{background-position:-30% 0}}
    .button:not(.button-unstyled):active{transform:scale(.97)}
    @media (prefers-reduced-motion:reduce){.ed24-rv{opacity:1;transform:none}.ed24-progress{display:none}}
  </style>
  <script>
    (function () {
      if (window.ed24Fx) return;
      window.ed24Fx = true;
      var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Roter Scroll-Fortschritt oben
      var bar = document.querySelector('.ed24-progress'), tick = 0;
      var upd = function () {
        tick = 0;
        var max = document.documentElement.scrollHeight - window.innerHeight;
        if (bar) bar.style.transform = 'scaleX(' + (max > 0 ? Math.min(1, window.scrollY / max) : 0).toFixed(4) + ')';
      };
      if (!still) {
        window.addEventListener('scroll', function () { if (!tick) tick = requestAnimationFrame(upd); }, { passive: true });
        upd();
      }
      // Produkte beim Scrollen weich einblenden (auch nach Filtern und Nachladen)
      if (still || !('IntersectionObserver' in window)) return;
      var io = new IntersectionObserver(function (entries) {
        var n = 0;
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.style.setProperty('--ed24-d', Math.min(n++, 6));
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        });
      }, { rootMargin: '0px 0px -6% 0px' });
      var scan = function (root) {
        (root || document).querySelectorAll('product-card.product-card:not([data-ed24-rv])').forEach(function (el) {
          el.setAttribute('data-ed24-rv', '');
          el.classList.add('ed24-rv');
          io.observe(el);
        });
      };
      var start = function () {
        scan();
        new MutationObserver(function (list) {
          for (var i = 0; i < list.length; i++) if (list[i].addedNodes.length) { scan(); break; }
        }).observe(document.body, { childList: true, subtree: true });
      };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true }); else start();
    })();
  </script>
{%- endif -%}
{%- if template.name == 'blog' and blog.handle == 'athleten' -%}
  <style>
    /* Athleten-Übersicht: gleichmäßiges Raster, Fotos im Hochformat mit ganzer Person */
    .blog-posts-container{grid-template-columns:repeat(2,minmax(0,1fr)) !important;gap:28px 14px !important}
    .blog-posts-container > .blog-post-item{grid-column:auto !important;grid-row:auto !important}
    .blog-post-item--horizontal > *{flex-direction:column !important}
    .blog-post-item--horizontal .blog-post-card__image-container,.blog-post-item--horizontal .blog-post-card__content{width:100% !important;max-width:none !important}
    .blog-post-card__image{height:auto !important;aspect-ratio:3/4;object-position:50% 12% !important;border-radius:14px}
    @media (min-width:750px){.blog-posts-container{grid-template-columns:repeat(3,minmax(0,1fr)) !important}}
    @media (min-width:1100px){.blog-posts-container{grid-template-columns:repeat(4,minmax(0,1fr)) !important}}
  </style>
{%- endif -%}
{%- if template.name == 'article' -%}
  <style>
    /* Fotogalerie in Athleten-Profilen */
    .ed24-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:24px 0 8px}
    .ed24-gallery img{width:100%;height:auto;aspect-ratio:3/4;object-fit:cover;object-position:50% 15%;border-radius:12px;margin:0 !important}
    @media (min-width:750px){.ed24-gallery{grid-template-columns:repeat(3,minmax(0,1fr))}}
    {%- if blog.handle == 'athleten' -%}
    .blog-post-featured-image__image{max-height:78vh;object-fit:contain !important}
    {%- endif -%}
  </style>
{%- endif -%}
{%- if template.name == 'product' -%}
  <style>
    /* Nährwerttabellen in Produktbeschreibungen (aus dem alten Shop als Zeilen mit „|“ übernommen) */
    .ed24-nutri-wrap{overflow-x:auto;margin:10px 0 18px;-webkit-overflow-scrolling:touch}
    .ed24-nutri{width:100%;min-width:420px;border-collapse:collapse;font-size:14px;line-height:1.35}
    .ed24-nutri th,.ed24-nutri td{padding:7px 10px;text-align:right;border-bottom:1px solid rgba(255,255,255,.08);white-space:nowrap}
    .ed24-nutri th:first-child,.ed24-nutri td:first-child{text-align:left;white-space:normal}
    .ed24-nutri thead th{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:13px;letter-spacing:.04em;text-transform:uppercase;color:#fff;background:{{ s.accent }};white-space:normal}
    .ed24-nutri tbody tr:nth-child(even){background:rgba(255,255,255,.04)}
    .ed24-nutri td.ed24-sub{padding-left:22px;color:#b4b4ba}
    /* Empfehlungen ausblenden, solange Shopify noch keine berechnet hat (sonst leere Kästen) */
    .product-recommendations:has(.product-recommendations__skeleton-item){display:none}
  </style>
  <script>
    (function () {
      function txt(el) { return (el.textContent || '').replace(/\s+/g, ' ').trim(); }
      function cells(t) { return t.split('|').map(function (c) { return c.trim(); }).filter(Boolean); }
      function fix(root) {
        var kids = Array.prototype.slice.call(root.children);
        for (var i = 0; i < kids.length; i++) {
          if (kids[i].tagName !== 'P' || txt(kids[i]).charAt(0) !== '|') continue;
          var head = [], rows = [], cur = null, j = i;
          for (; j < kids.length; j++) {
            var el = kids[j], t = txt(el), next = kids[j + 1] ? txt(kids[j + 1]) : '';
            if (el.tagName !== 'P') break;
            if (t.charAt(0) === '|') { var c = cells(t); if (!c.length) continue; (cur ? cur.c : head).push.apply(cur ? cur.c : head, c); }
            else if (t.charAt(0) === '(' && t.length < 90) { var arr = cur ? cur.c : head; if (arr.length) arr[arr.length - 1] += ' ' + t; else if (cur) cur.l += ' ' + t; }
            else if (t.length <= 70 && next.charAt(0) === '|') { cur = { l: t, c: [] }; rows.push(cur); }
            else break;
          }
          if (rows.length < 2) { i = j; continue; }
          var n = Math.max(head.length, rows.reduce(function (m, r) { return Math.max(m, r.c.length); }, 0));
          var h = '<div class="ed24-nutri-wrap"><table class="ed24-nutri">';
          if (head.length) { h += '<thead><tr><th></th>'; for (var k = 0; k < n; k++) h += '<th>' + (head[k] || '') + '</th>'; h += '</tr></thead>'; }
          h += '<tbody>';
          rows.forEach(function (r) {
            var sub = /^[-–]\s*/.test(r.l);
            h += '<tr><td' + (sub ? ' class="ed24-sub"' : '') + '>' + r.l.replace(/^[-–]\s*/, '') + '</td>';
            for (var k = 0; k < n; k++) h += '<td>' + (r.c[k] || '') + '</td>';
            h += '</tr>';
          });
          h += '</tbody></table></div>';
          var box = document.createElement('div'); box.innerHTML = h;
          root.insertBefore(box.firstChild, kids[i]);
          for (var x = i; x < j; x++) kids[x].remove();
          i = j - 1;
        }
      }
      function run() {
        document.querySelectorAll('main p').forEach(function (p) {
          var par = p.parentElement;
          if (!par || par.dataset.ed24Nutri || txt(p).charAt(0) !== '|') return;
          par.dataset.ed24Nutri = '1'; fix(par);
        });
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
    })();
  </script>
{%- endif -%}
<div class="ed24-topbar" style="background-color: {{ s.accent }};">
  <div class="ed24-topbar__inner">
    {%- if s.left != blank -%}
      <a class="ed24-topbar__item ed24-topbar__item--side" href="{{ s.left_link | default: routes.root_url }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg>
        {{- s.left | escape -}}
      </a>
    {%- endif -%}
    {%- if s.center != blank -%}
      <span class="ed24-topbar__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="9" width="16" height="11" rx="1.5"/><path d="M3 9h18M12 9v11M12 9c-2-4-6-4-6-1.5S10 9 12 9c2 0 6-.5 6-3S14 5 12 9Z"/></svg>
        {{- s.center | escape -}}
      </span>
    {%- endif -%}
    {%- if s.right != blank -%}
      <a class="ed24-topbar__item ed24-topbar__item--side" href="tel:{{ phone_link }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
        {{- s.right | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ed24-topbar{color:#fff;font-family:'Barlow',sans-serif;font-size:13px;font-weight:600;line-height:1.2}
  .ed24-topbar__inner{max-width:1280px;margin:0 auto;padding:0 clamp(16px,3vw,28px);min-height:34px;display:flex;align-items:center;justify-content:center;gap:28px;white-space:nowrap;overflow:hidden}
  .ed24-topbar .ed24-topbar__item{display:inline-flex;align-items:center;gap:7px;color:#fff;text-decoration:none}
  .ed24-topbar__item svg{width:15px;height:15px;flex-shrink:0}
  .ed24-topbar .ed24-topbar__item--side{display:none}
  @media (min-width:900px){
    .ed24-topbar__inner{justify-content:space-between}
    .ed24-topbar .ed24-topbar__item--side{display:inline-flex}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ED24 Topbar",
  "tag": "section",
  "class": "ed24-section",
  "settings": [
    { "type": "text", "id": "left", "label": "Text links", "default": "Laden in Rostock · Doberaner Str. 110–112" },
    { "type": "url", "id": "left_link", "label": "Link links", "info": "Zum Beispiel eine Seite „Laden & Team“." },
    { "type": "text", "id": "center", "label": "Text Mitte", "default": "Überraschung ab 100 € Einkaufswert" },
    { "type": "text", "id": "right", "label": "Text rechts", "default": "Beratung: 0381 – 203 38 71" },
    { "type": "text", "id": "phone", "label": "Telefonnummer (für den Link rechts)", "default": "0381 – 203 38 71" },
    { "type": "color", "id": "accent", "label": "Farbe", "default": "#e30613" },
    { "type": "checkbox", "id": "brand_fonts", "label": "Markenschriften im ganzen Shop", "info": "Überschriften kursiv, fett und in Großbuchstaben (Barlow Condensed), alle anderen Texte in Barlow.", "default": true },
    { "type": "checkbox", "id": "effects", "label": "Effekte im ganzen Shop", "info": "Roter Scroll-Fortschritt, Produkte blenden beim Scrollen ein, Glow auf Produktkarten, Glanz auf Buttons, rote Menü-Linie.", "default": true }
  ],
  "presets": [{ "name": "ED24 Topbar" }]
}
{% endschema %}
