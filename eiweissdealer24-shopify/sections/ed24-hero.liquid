{%- comment -%}
  ED24 Hero 3D – Eiweissdealer24
  Riesiger Schriftzug, fließender Farbverlauf (WebGL) und schwebende echte Produkte (freigestellte Bestseller-Bilder).
  Dieser Abschnitt steuert auch die 3D-Effekte von „ED24 Produkt-Showcase“ und „ED24 Story“.
  Reihenfolge auf der Startseite: Hero → Showcase → Story → Coaching-Panel.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Barlow:wght@400;500;600;700&display=swap">

<div
  class="ed24-hero"
  data-ed24-hero
  data-color="{{ section.settings.accent }}"
  data-dark="{{ section.settings.dark }}"
  style="--ed24-accent: {{ section.settings.accent }}; --ed24-dark: {{ section.settings.dark }};"
>
  {%- if section.settings.show_3d -%}
    <ed24-stage class="ed24-stage" aria-hidden="true">
      <canvas class="ed24-stage__bg" data-bg></canvas>
      <canvas class="ed24-stage__fx" data-fx></canvas>
      {%- assign ed24_ff = section.settings.float_files | default: 'ed24-float-on-gold-standard.png, ed24-float-srs-supreme-whey.png, ed24-float-weider-60-bar.png, ed24-float-weider-protein-80.png, ed24-float-bloodstorm.png, ed24-float-ami-no-xpress.png, ed24-float-weider-magnesium.png, ed24-float-nutrend-whey-core.png, ed24-float-iso-whey-clear.png, ed24-float-vast-total-amino.png, ed24-float-iso-whey-zero.png, ed24-float-blender-bottle.png, ed24-float-scitec-whey.png' | strip_newlines | split: ',' -%}
      <script type="application/json" data-ed24-floats>[{%- for f in ed24_ff -%}{%- assign fn = f | strip -%}{%- assign im = images[fn] -%}{%- if im != blank -%}{{ im | image_url: width: 640 | json }}{%- else -%}""{%- endif -%}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]</script>
    </ed24-stage>
  {%- endif -%}

  <h1 class="ed24-hero__inner">
    <span class="ed24-hero__word">{{ section.settings.line_1 }}</span>
    <span class="ed24-hero__word">{{ section.settings.line_2 }}</span>
  </h1>

  <div class="ed24-hero__meta">
    <p class="ed24-hero__metatext">{{ section.settings.meta_left | escape }}</p>
    <p class="ed24-hero__metatext ed24-hero__metatext--end">{{ section.settings.meta_right | escape }}</p>
  </div>

  {%- assign ed24_c1 = section.settings.cta_label | default: 'Jetzt shoppen' -%}{%- assign ed24_c2 = section.settings.cta2_label | default: 'Angebote' -%}{%- if ed24_c1 != blank or ed24_c2 != blank -%}
    <div class="ed24-hero__cta">
      {%- if ed24_c1 != blank -%}<a class="ed24-hero__btn" href="{{ section.settings.cta_link | default: '/pages/shop' }}">{{ ed24_c1 | escape }}</a>{%- endif -%}
      {%- if ed24_c2 != blank -%}<a class="ed24-hero__btn ed24-hero__btn--line" href="{{ section.settings.cta2_link | default: '/collections/angebote' }}">{{ ed24_c2 | escape }}</a>{%- endif -%}
    </div>
  {%- endif -%}
  <a class="ed24-ring" href="#ed24-showcase" aria-label="{{ section.settings.scroll_label | escape }}">
    <svg class="ed24-ring__text" viewBox="0 0 100 100" aria-hidden="true">
      <defs><path id="ed24-circ-{{ section.id }}" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0"/></defs>
      <text><textPath href="#ed24-circ-{{ section.id }}" textLength="238" lengthAdjust="spacing">{{ section.settings.scroll_text | escape }}</textPath></text>
    </svg>
    <span class="ed24-ring__arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v16m-6-6 6 6 6-6"/></svg>
    </span>
  </a>
</div>

{% stylesheet %}
  .ed24-hero{position:relative;min-height:max(560px,92svh);display:flex;align-items:center;justify-content:center;overflow:clip;color:#fff;text-align:center;padding:48px 16px 150px;background:linear-gradient(180deg,var(--ed24-accent,#e30613) 0%,var(--ed24-dark,#120405) 88%)}
  .ed24-stage{display:contents}
  ed24-stage>.ed24-stage__bg,ed24-stage>.ed24-stage__fx{display:none}
  /* Die Effekt-Ebenen liegen in einem Rahmen von der Hero-Oberkante bis zum Coaching-Panel und kleben darin oben am Bildschirm.
     Rahmen und Kleben übernimmt der Browser selbst (overflow: clip, position: sticky), deshalb bleiben die Ränder auch auf iPad und iPhone ruhig. */
  .ed24-stage__clip{position:absolute;left:0;top:0;width:100%;height:0;margin:0;padding:0;overflow:hidden;overflow:clip;pointer-events:none;visibility:hidden}
  @supports not (overflow:clip){.ed24-stage__clip{overflow:visible;clip-path:inset(0)}}
  .ed24-stage__clip--bg{z-index:0}
  .ed24-stage__clip--fx{z-index:2}
  .ed24-stage__track{position:absolute;left:0;top:0;width:100%;margin:0;padding:0}
  .ed24-stage__bg,.ed24-stage__fx{position:sticky;top:0;left:0;width:100%;max-width:none;margin:0;display:block;pointer-events:none}
  .ed24-stage__bg{height:125vh}
  .ed24-stage__fx{height:115vh}
  html.ed24-nogl .ed24-stage__bg,html.ed24-nogl .ed24-stage__fx{display:none}
  .ed24-hero__inner{position:relative;z-index:1;margin:0;display:flex;flex-direction:column;align-items:center;font-family:'Barlow Condensed',sans-serif;font-weight:800;font-style:italic;text-transform:uppercase;font-size:clamp(84px,18.5vw,330px);line-height:.8;letter-spacing:-.005em;color:#fff;will-change:transform,opacity}
  .ed24-hero .ed24-hero__inner{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-style:italic;text-transform:uppercase;line-height:.8;color:#fff}
  .ed24-hero__word{display:block;white-space:nowrap}
  .ed24-hero__word strong,.ed24-hero__word b{color:transparent;-webkit-text-stroke:.03em #fff;font-weight:800}
  .ed24-hero__word em{font-style:italic}
  .ed24-hero__meta{position:absolute;z-index:1;left:0;right:0;bottom:0;padding:0 clamp(16px,3vw,36px) 26px;display:flex;justify-content:space-between;align-items:flex-end;gap:20px;text-align:start}
  .ed24-hero__metatext{max-width:220px;margin:0;font-family:'Barlow',sans-serif;font-size:13px;font-weight:600;line-height:1.4;letter-spacing:.06em;text-transform:uppercase;color:#fff}
  .ed24-hero__metatext--end{text-align:end}
  .ed24-ring{position:absolute;z-index:1;left:50%;bottom:22px;width:96px;height:96px;margin-left:-48px;color:#fff;text-decoration:none}
  .ed24-hero{padding-bottom:220px}
  .ed24-hero__cta{position:absolute;z-index:3;left:0;right:0;bottom:132px;display:flex;justify-content:center;gap:10px;flex-wrap:wrap;padding:0 16px}
  .ed24-hero .ed24-hero__btn{display:inline-flex;align-items:center;min-height:48px;padding:0 24px;border-radius:999px;background:#fff;color:#111;font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:17px;letter-spacing:.05em;text-transform:uppercase;text-decoration:none;box-shadow:0 10px 30px rgba(0,0,0,.35);transition:transform .2s}
  .ed24-hero .ed24-hero__btn:hover{transform:translateY(-2px)}
  .ed24-hero .ed24-hero__btn--line{background:rgba(0,0,0,.25);color:#fff;border:1.5px solid rgba(255,255,255,.7);box-shadow:none;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
  .ed24-ring__text{display:block;width:100%;height:100%}
  .ed24-ring text{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:11.5px;letter-spacing:3.2px;fill:currentColor;text-transform:uppercase}
  .ed24-ring__arrow{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
  .ed24-ring__arrow svg{width:22px;height:22px}
  @media (prefers-reduced-motion:no-preference){
    .ed24-hero__word{animation:ed24-rise 1s cubic-bezier(.2,.8,.2,1) both}
    .ed24-hero__word+.ed24-hero__word{animation-delay:.08s}
    .ed24-ring__text{animation:ed24-spin 12s linear infinite}
    .ed24-ring__arrow svg{animation:ed24-bob 1.6s ease-in-out infinite}
    @supports (animation-timeline:view()){
      .ed24-hero__inner{animation:ed24-out linear both;animation-timeline:view();animation-range:exit 0% exit 100%}
    }
  }
  @keyframes ed24-rise{from{opacity:0;transform:translateY(40%)}}
  @keyframes ed24-out{to{opacity:0;transform:translateY(35%) scale(.92)}}
  @keyframes ed24-spin{to{transform:rotate(360deg)}}
  @keyframes ed24-bob{50%{transform:translateY(5px)}}
  @media (max-width:749px){.ed24-hero__metatext{display:none}}
{% endstylesheet %}

{% javascript %}
  // 3D-Bühne für die ED24-Startseite: Farbverlauf (WebGL) und 3D-Produkte (Three.js), gesteuert über die Scroll-Position.
  // Gezeichnet wird nur im Bereich der ED24-Abschnitte – nie über der Kopfzeile oder anderen Abschnitten.
  var THREE_URL = 'https://cdn.jsdelivr.net/npm/three@0.149.0/build/three.min.js';
  var SKY = 'M0 20V14h8v-4h6v4h6V8l3-6 3 6v6h8v-3h8v3h6V6h2V3h2v3h2v8h8V9h8v5h6v-4l4-10 4 10v4h8v-2h8V7h4v7h8v-3h8v9z';
  var clamp = function (v, a, b) { a = a === undefined ? 0 : a; b = b === undefined ? 1 : b; return Math.min(b, Math.max(a, v)); };
  var lerp = function (a, b, t) { return a + (b - a) * t; };
  var easeIO = function (t) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; };
  var easeOut = function (t) { return 1 - Math.pow(1 - t, 3); };
  var easeIn = function (t) { return t * t * t; };
  var easeBack = function (t) { return 1 + 2.70158 * Math.pow(t - 1, 3) + 1.70158 * Math.pow(t - 1, 2); };
  // Feste Bildschirmhöhe (100svh): bleibt gleich, wenn Safari beim Scrollen die Adressleiste ein- oder ausblendet.
  if (!window.ed24Vh) {
    window.ed24Vh = (function () {
      var probe, v = 0;
      window.addEventListener('resize', function () { v = 0; }, { passive: true });
      return function () {
        if (!v) {
          if (!probe) {
            probe = document.createElement('div');
            probe.setAttribute('aria-hidden', 'true');
            probe.style.cssText = 'position:fixed;left:0;top:0;width:0;height:100vh;height:100svh;visibility:hidden;pointer-events:none';
            (document.body || document.documentElement).appendChild(probe);
          }
          v = probe.offsetHeight || window.innerHeight;
        }
        return v;
      };
    })();
  }
  var ed24Vw = function () { return document.documentElement.clientWidth || window.innerWidth; };
  var threePromise = null;
  function loadThree() {
    if (window.THREE) return Promise.resolve();
    if (!threePromise) {
      threePromise = new Promise(function (res, rej) {
        var s = document.createElement('script');
        s.src = THREE_URL;
        s.async = true;
        s.onload = res;
        s.onerror = function () { threePromise = null; rej(new Error('three')); };
        document.head.appendChild(s);
      });
    }
    return threePromise;
  }
  function hex2v(T, h) {
    var n = parseInt(String(h || '').replace('#', '').slice(0, 6), 16);
    if (isNaN(n)) n = 0xe30613;
    return new T.Vector3(((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255);
  }
  var HERO = {
    d: { tubA: [0.52, -0.3, 0.86, 0.22, -0.45, -0.16], tubB: [-0.56, 0.36, 0.74, 0.32, 0.6, 0.42], tubC: [0.73, 0.46, 0.6, -0.2, -0.3, -0.55], dumb: [-0.6, -0.56, 0.74, 0.5, 0.3, 0.28], scoop: [0.8, -0.64, 0.55, 0.7, 0.8, -0.35] },
    m: { tubA: [0.55, -0.64, 0.85, 0.22, -0.45, -0.16], tubB: [-0.55, 0.5, 0.7, 0.32, 0.6, 0.42], tubC: [0.62, 0.48, 0.56, -0.2, -0.3, -0.55], dumb: [-0.58, -0.74, 0.66, 0.5, 0.3, 0.28], scoop: [0.05, 0.28, 0.5, 0.7, 0.8, -0.35] }
  };
  var SHOW = { d: { tub: [0.16, -0.06, 1.12], comp: [-0.14, -0.5, 0.82] }, m: { tub: [0, -0.04, 1.45], comp: [0.5, -0.34, 0.8] } };
  var EXIT = { tubB: [-1.5, 1.5], tubC: [1.5, 1.5], scoop: [0.3, 1.7] };
  var FLOAT = [['f1', 0.08, 0.7, 1.3, 0.8, 0.7], ['f2', 0.2, -0.72, 0.85, 0.8, 0.6], ['f3', 0.42, 0.74, 1.15, 0.75, 0.55], ['f4', 0.55, -0.6, 1.4, 0.7, 0.5], ['f5', 0.75, 0.62, 0.9, 0.7, 0.6], ['f6', 0.9, -0.66, 1.25, 0.75, 0.55]];
  var QUALITY = [{ fx: 1.5, bg: 0.4 }, { fx: 1.25, bg: 0.33 }, { fx: 1, bg: 0.28 }, { fx: 0.8, bg: 0.22 }];
  // Farbfläche und 3D-Ebene ragen unter die Bildschirmhöhe: Auch wenn Safari die Adressleiste ausblendet und mehr Fläche zeigt, bleibt kein Rand und kein abgeschnittenes Produkt.
  var BG_EXT = 0.25, FX_EXT = 0.15;
  var FRAG = [
    'precision mediump float; varying vec2 vUv;',
    'uniform float uTime,uWipe,uSplit,uExt; uniform vec2 uRes; uniform vec3 uPrev,uNext,uLight;',
    'float h(vec2 p){ return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }',
    'float n(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f); return mix(mix(h(i),h(i+vec2(1,0)),f.x), mix(h(i+vec2(0,1)),h(i+vec2(1,1)),f.x), f.y); }',
    'float fbm(vec2 p){ float v=0., a=.5; for(int i=0;i<3;i++){ v+=a*n(p); p=p*2.03+vec2(1.7,9.2); a*=.5; } return v; }',
    'void main(){ vec2 uv=vec2(vUv.x, vUv.y*(1.+uExt)-uExt); float asp=uRes.x/uRes.y; vec2 p=vec2(uv.x*asp,uv.y); float t=uTime*.07;',
    'float q=fbm(p*1.1+vec2(t,-t*.7)); float r=fbm(p*2.2+vec2(-t*.6,t*.4)+q*1.6);',
    'float wave=uv.y + .16*sin(p.x*1.9+uTime*.22+q*3.2) + .24*(r-.5);',
    'float edge=uv.y + .07*sin(p.x*4.+uTime*.9) + .08*(q-.5);',
    'float w=1.-smoothstep(uWipe-.07,uWipe+.07,edge);',
    'vec3 col=mix(uPrev,uNext,w); float k=smoothstep(uSplit-.3,uSplit+.3,wave);',
    'vec3 c=mix(uLight,col,k); float band=exp(-pow((wave-uSplit-.02)*7.,2.));',
    'c=mix(c, mix(c,vec3(1.),.35), band*.45*k); gl_FragColor=vec4(c,1.); }'
  ].join('\n');

  class Ed24Stage extends HTMLElement {
    connectedCallback() {
      var self = this;
      this.ctrl = new AbortController();
      this.bgC = this.querySelector('[data-bg]');
      this.fxC = this.querySelector('[data-fx]');
      this.still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var rebuild = function () {
        clearTimeout(self.rbT);
        self.rbT = setTimeout(function () {
          if (!self.isConnected || !self.ready) return;
          self.teardown();
          self.setup();
        }, 200);
      };
      ['shopify:section:load', 'shopify:section:unload', 'shopify:section:reorder'].forEach(function (e) {
        document.addEventListener(e, rebuild, { signal: self.ctrl.signal });
      });
      loadThree()
        .then(function () { return document.fonts && document.fonts.ready ? document.fonts.ready : null; })
        .then(function () { self.setup(); })
        .catch(function () { self.fail(); });
    }

    disconnectedCallback() {
      if (this.ctrl) this.ctrl.abort();
      clearTimeout(this.rbT);
      this.teardown();
      (this.wraps || []).forEach(function (w) { w.clip.remove(); });
      this.wraps = null;
    }

    fail() {
      // Ohne WebGL bleibt der Farbverlauf aus CSS, Inhalte und Buttons funktionieren trotzdem.
      document.documentElement.classList.add('ed24-nogl');
      (this.wraps || []).forEach(function (w) { w.clip.style.visibility = 'hidden'; });
    }

    teardown() {
      cancelAnimationFrame(this.raf);
      this.raf = 0;
      this.ready = false;
      if (this.loopCtrl) this.loopCtrl.abort();
      if (this.ro) this.ro.disconnect();
      var disposeScene = function (scene) {
        if (!scene) return;
        scene.traverse(function (o) {
          if (o.geometry) o.geometry.dispose();
          if (o.material) {
            (Array.isArray(o.material) ? o.material : [o.material]).forEach(function (m) {
              if (m.map) m.map.dispose();
              m.dispose();
            });
          }
        });
      };
      disposeScene(this.scene);
      disposeScene(this.bgScene);
      this.gen = (this.gen || 0) + 1;
      (this.texs || []).forEach(function (t) { t.dispose(); });
      this.texs = [];
      if (this.envTex) this.envTex.dispose();
      if (this.R) this.R.dispose();
      if (this.BR) this.BR.dispose();
      this.R = this.BR = this.scene = this.bgScene = this.envTex = null;
      (this.wraps || []).forEach(function (w) { w.clip.style.visibility = 'hidden'; });
      this.on = null;
    }

    setup() {
      if (!this.isConnected || !window.THREE) return;
      var T = window.THREE, self = this;
      this.loopCtrl = new AbortController();
      var opts = { signal: this.loopCtrl.signal, passive: true };
      this.hero = this.closest('[data-ed24-hero]');
      this.show = document.querySelector('[data-ed24-showcase]');
      this.story = document.querySelector('[data-ed24-story]');
      this.coach = document.querySelector('[data-ed24-coach]');
      this.mount();
      var brand = (this.hero && this.hero.dataset.color) || '#e30613';
      var dark = (this.hero && this.hero.dataset.dark) || '#120405';
      this.ch = this.show ? Array.prototype.slice.call(this.show.querySelectorAll('[data-ed24-chapter]')).map(function (el) {
        return { col: el.dataset.color || brand, img: el.dataset.img || '', l1: (el.dataset.label1 || '').toUpperCase(), l2: (el.dataset.label2 || '').toUpperCase(), body: el.dataset.body === 'light' ? '#f1f1f1' : '#121212' };
      }) : [];
      if (!this.ch.length) this.ch = [{ col: brand, img: '', l1: 'PROTEIN', l2: '', body: '#121212' }];
      var fl = this.querySelector('[data-ed24-floats]');
      try { this.floats = JSON.parse(fl ? fl.textContent : '[]') || []; } catch (e) { this.floats = []; }
      this.texs = [];
      if (!this.gen) this.gen = 1;
      try {
        if (T.ColorManagement) T.ColorManagement.legacyMode = false;
        this.R = new T.WebGLRenderer({ canvas: this.fxC, antialias: window.devicePixelRatio < 1.5 && window.innerWidth >= 750, alpha: true, powerPreference: 'high-performance' });
        this.R.outputEncoding = T.sRGBEncoding;
        this.R.toneMapping = T.ACESFilmicToneMapping;
        this.R.toneMappingExposure = 1.05;
        this.BR = new T.WebGLRenderer({ canvas: this.bgC, powerPreference: 'high-performance' });
      } catch (e) {
        this.fail();
        return;
      }
      this.COL = this.ch.map(function (c) { return hex2v(T, c.col); });
      this.C_RED = hex2v(T, brand);
      this.C_DARK = hex2v(T, dark);
      this.C_PAPER = hex2v(T, '#efece6');
      this.bgScene = new T.Scene();
      this.bgCam = new T.Camera();
      this.bgMat = new T.ShaderMaterial({
        uniforms: { uTime: { value: 0 }, uRes: { value: new T.Vector2(1, 1) }, uPrev: { value: this.C_RED.clone() }, uNext: { value: this.C_RED.clone() }, uLight: { value: this.C_DARK.clone() }, uWipe: { value: -1 }, uSplit: { value: 0.4 }, uExt: { value: BG_EXT } },
        vertexShader: 'varying vec2 vUv; void main(){ vUv=uv; gl_Position=vec4(position.xy,0.,1.); }',
        fragmentShader: FRAG
      });
      this.bgScene.add(new T.Mesh(new T.PlaneGeometry(2, 2), this.bgMat));
      this.scene = new T.Scene();
      this.cam = new T.PerspectiveCamera(35, 1, 0.1, 100);
      this.cam.position.set(0, 0, 10);
      this.scene.add(new T.HemisphereLight(0xffffff, 0x3a3a3a, 0.9));
      var key = new T.DirectionalLight(0xffffff, 2.4); key.position.set(4, 6, 8); this.scene.add(key);
      this.rim = new T.DirectionalLight(0xe30613, 3.2); this.rim.position.set(-6, 3, -5); this.scene.add(this.rim);
      var fill = new T.DirectionalLight(0xffffff, 0.6); fill.position.set(-5, -2, 6); this.scene.add(fill);
      // Großes Produkt im Showcase: pro Kapitel das Produktbild aus dem Kapitel.
      this.chTex = this.ch.map(function (c, i) {
        return self.loadTex(c.img || self.floats[0] || '', function (tx) {
          var g = self.O && self.O.tubA && self.O.tubA.g;
          if (g && g.userData.i === i) g.userData.apply(tx);
        });
      });
      this.buildObjects(T);
      this.V = { halfW: 5, halfH: 3, sf: 1 };
      this.QL = window.innerWidth < 750 || (navigator.hardwareConcurrency || 8) <= 4 ? 1 : 0;
      this.mouse = { x: 0, y: 0, tx: 0, ty: 0 };
      window.addEventListener('pointermove', function (e) { self.mouse.tx = (e.clientX / window.innerWidth) * 2 - 1; self.mouse.ty = (e.clientY / window.innerHeight) * 2 - 1; }, opts);
      // Safari meldet das Ein- und Ausblenden der Adressleiste als Größenänderung. Neu gerechnet wird nur, wenn sich Breite oder Bildschirmhöhe wirklich ändern (z. B. beim Drehen).
      window.addEventListener('resize', function () {
        clearTimeout(self.rt);
        self.rt = setTimeout(function () {
          if (!self.ready) return;
          if (ed24Vw() === self.lastW && Math.abs(window.ed24Vh() - self.lastH) < 2) return;
          self.resize();
