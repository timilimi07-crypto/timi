    { "type": "text", "id": "meta_left", "label": "Text unten links", "default": "Supplements, Ernährungs- & Trainingscoaching" },
    { "type": "text", "id": "meta_right", "label": "Text unten rechts", "default": "Rostock · Doberaner Str. 110–112 · seit 2007" },
    { "type": "text", "id": "scroll_text", "label": "Text im Scroll-Kreis", "info": "Kurz halten (rund 25 Zeichen), dann passt der Text genau einmal um den Kreis.", "default": "Scroll · Stärker werden · 24 ·" },
    { "type": "text", "id": "scroll_label", "label": "Beschriftung Scroll-Kreis (Screenreader)", "default": "Weiter zum Produkt-Showcase" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta_label", "label": "Button 1 Text", "default": "Jetzt shoppen" },
    { "type": "text", "id": "cta_link", "label": "Button 1 Link", "default": "/pages/shop" },
    { "type": "text", "id": "cta2_label", "label": "Button 2 Text", "default": "Angebote" },
    { "type": "text", "id": "cta2_link", "label": "Button 2 Link", "default": "/collections/angebote" },
    { "type": "header", "content": "Effekte & Farben" },
