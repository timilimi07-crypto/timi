    { "type": "paragraph", "content": "Die 3D-Produkte sind fest eingebaut. Etikett und Dosenfarbe der großen Dose stellst du in den Kapiteln im „ED24 Produkt-Showcase“ ein." },
    { "type": "color", "id": "accent", "label": "Markenfarbe", "default": "#e30613" },
    { "type": "color", "id": "dark", "label": "Dunkle Farbe", "default": "#120405" }
