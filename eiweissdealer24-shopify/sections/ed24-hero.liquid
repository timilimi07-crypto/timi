{% schema %}
{
  "name": "ED24 Hero 3D",
  "tag": "section",
  "class": "ed24-section",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Schriftzug" },
    { "type": "inline_richtext", "id": "line_1", "label": "Zeile 1", "default": "Eiweiss" },
    { "type": "inline_richtext", "id": "line_2", "label": "Zeile 2", "info": "Fett gesetzter Text erscheint als Umriss.", "default": "Dealer<strong>24</strong>" },
    { "type": "text", "id": "meta_left", "label": "Text unten links", "default": "Supplements, Ernährungs- & Trainingscoaching" },
    { "type": "text", "id": "meta_right", "label": "Text unten rechts", "default": "Rostock · Doberaner Str. 110–112 · seit 2007" },
    { "type": "text", "id": "scroll_text", "label": "Text im Scroll-Kreis", "info": "Kurz halten (rund 25 Zeichen), dann passt der Text genau einmal um den Kreis.", "default": "Scroll · Stärker werden · 24 ·" },
    { "type": "text", "id": "scroll_label", "label": "Beschriftung Scroll-Kreis (Screenreader)", "default": "Weiter zum Produkt-Showcase" },
    { "type": "header", "content": "Effekte & Farben" },
    { "type": "checkbox", "id": "show_3d", "label": "Schwebende Produkte und Farbverlauf anzeigen", "default": true },
    { "type": "paragraph", "content": "Die schwebenden Produkte fügst du unten als Blöcke hinzu. Das große Produkt in der Mitte kommt aus den Kapiteln im „ED24 Produkt-Showcase“." },
    { "type": "color", "id": "accent", "label": "Markenfarbe", "default": "#e30613" },
    { "type": "color", "id": "dark", "label": "Dunkle Farbe", "default": "#120405" }
  ],
  "blocks": [
    {
      "type": "floater",
      "name": "Schwebendes Produkt",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Freigestelltes Produktbild", "info": "PNG ohne Hintergrund, dann schwebt das Produkt frei." },
        { "type": "product", "id": "product", "label": "Produkt", "info": "Ohne eigenes Bild wird das Hauptbild dieses Produkts verwendet." }
      ]
