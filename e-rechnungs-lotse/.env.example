# Vorlage – kopieren nach .env und anpassen. .env NIE committen.
# Alle Werte hier sind lokale Platzhalter, keine echten Zugangsdaten.

# --- Web ---
WEB_PORT=3000

# --- PostgreSQL ---
POSTGRES_USER=erl
POSTGRES_PASSWORD=erl
POSTGRES_DB=erl
POSTGRES_PORT=5432
# Für `pnpm migrate` / `pnpm dev` außerhalb von Docker:
DATABASE_URL=postgres://erl:erl@localhost:5432/erl

# --- Objektspeicher (lokal MinIO, Produktion: S3-kompatibler Speicher in der EU) ---
MINIO_ROOT_USER=erl-local
MINIO_ROOT_PASSWORD=erl-local-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=erl-originale

# --- KoSIT-Validator (Versionen für Updates hier ändern) ---
VALIDATOR_PORT=8081
VALIDATOR_URL=http://localhost:8081
VALIDATOR_VERSION=1.6.3
XRECHNUNG_VERSION=3.0.2
XRECHNUNG_CONFIG_RELEASE=2026-08-31
# SHA-256 der Downloads – bei jedem Versionswechsel neu eintragen (Container-Build prüft sie)
VALIDATOR_SHA256=799e64befca97d4080e03608c80b85dd5a5ecc5f4ae4f35d1116ec2855b9a7c9
XRECHNUNG_CONFIG_SHA256=2530cd107c414511c5d0462ec10f886910395abfca820db82e83d70bf01221a8

# --- LLM (zentral über packages/core/src/llm, Standard AUS) ---
# Nur EU-Endpunkte, die in docs/subprozessoren.md eingetragen sind.
LLM_ENABLED=false
LLM_ENDPOINT=
LLM_ALLOWED_HOSTS=
# API-Schlüssel nur über Secret-Management, nie in Dateien im Repo.
LLM_API_KEY=

# --- Optional: zusätzliche CA-Datei für TLS-prüfende Proxys beim Docker-Build ---
# EXTRA_CA_FILE=/pfad/zur/ca.pem
