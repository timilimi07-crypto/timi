{{ 'collection.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<div class="coll-banner">
  <div class="page-width coll-banner__inner">
    <p class="eyebrow">{{ 'search.title' | t }}</p>
    <h1 class="h1">
      {%- if search.performed -%}
        <span class="text-chrome">„{{ search.terms | escape }}“</span>
      {%- else -%}
        <span class="text-chrome">{{ s.heading | escape }}</span>
      {%- endif -%}
    </h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-hero__form">
      <label for="SearchPageInput" class="visually-hidden">{{ 'general.search.search' | t }}</label>
      <input id="SearchPageInput" class="input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="btn btn--primary"><span class="btn__label">{{ 'general.search.submit' | t }}</span></button>
    </form>
    {%- if search.performed -%}
      <p class="text-muted">{{ 'search.results' | t: count: search.results_count, terms: search.terms }}</p>
    {%- endif -%}
  </div>
</div>

<div class="page-width" data-facets-section="{{ section.id }}" style="padding-bottom: var(--section-gap);">
  {%- if search.performed -%}
    {%- paginate search.results by s.per_page -%}
      {%- if s.enable_filtering and search.filters.size > 0 -%}
        {% render 'facets', results: search, count: search.results_count, terms: search.terms %}
      {%- endif -%}
      {%- if search.results_count > 0 -%}
        <div class="grid product-grid" style="--cols: {{ s.columns }}; --cols-tablet: 3; --cols-mobile: 2;">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              <div>{% render 'product-card', product: item, index: forloop.index0 %}</div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- capture others -%}
          {%- for item in search.results -%}
            {%- unless item.object_type == 'product' -%}
              <a href="{{ item.url }}"><span>{{ item.title | escape }}</span><span class="text-muted">{% if item.object_type == 'article' %}Blog{% else %}{{ 'search.title' | t }}{% endif %} →</span></a>
            {%- endunless -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if others != blank -%}<div class="search-other">{{ others }}</div>{%- endif -%}
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="empty-state product-grid"><p class="h3">{{ 'search.no_results' | t: terms: search.terms }}</p></div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Suchergebnisse",
  "tag": "section",
  "class": "section-main-search",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift (ohne Suche)", "default": "Find your fit" },
    { "type": "checkbox", "id": "enable_filtering", "label": "Filter & Sortierung", "default": true },
    { "type": "range", "id": "per_page", "label": "Ergebnisse pro Seite", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "Spalten (Desktop)", "min": 2, "max": 5, "step": 1, "default": 4 }
  ]
}
{% endschema %}
