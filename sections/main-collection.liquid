{{ 'collection.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<div class="coll-banner">
  {%- if s.show_image and collection.image -%}
    <div class="coll-banner__media" aria-hidden="true">{% render 'image', image: collection.image, sizes: '100vw', eager: true, alt: '' %}</div>
  {%- endif -%}
  <div class="page-width coll-banner__inner">
    <p class="eyebrow">{{ s.eyebrow | escape }}</p>
    <h1 class="h1"><span class="text-chrome is-animated" {% if settings.scramble_enable %}data-scramble{% endif %}>{{ collection.title | escape }}</span></h1>
    {%- if s.show_description and collection.description != blank -%}<div class="rte text-muted coll-banner__desc">{{ collection.description }}</div>{%- endif -%}
  </div>
</div>

<div class="page-width" data-facets-section="{{ section.id }}" style="padding-bottom: var(--section-gap);">
  {%- paginate collection.products by s.per_page -%}
    {%- if s.enable_filtering -%}
      {% render 'facets', results: collection, count: collection.products_count %}
    {%- endif -%}
    {%- if collection.products.size > 0 -%}
      <div class="grid product-grid" style="--cols: {{ s.columns }}; --cols-tablet: 3; --cols-mobile: {{ s.columns_mobile }};">
        {%- for product in collection.products -%}
          {%- assign is_eager = false -%}
          {%- if forloop.index <= 2 -%}{%- assign is_eager = true -%}{%- endif -%}
          <div>{% render 'product-card', product: product, index: forloop.index0, eager: is_eager %}</div>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <div class="empty-state product-grid">
        <p class="h3">{% if collection.all_products_count == 0 %}{{ 'collections.general.empty' | t }}{% else %}{{ 'collections.general.no_matches' | t }}{% endif %}</p>
        {%- assign all_label = 'collections.general.view_all' | t -%}
        {% render 'button', label: all_label, url: routes.all_products_collection_url, style: 'outline' %}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Kollektion",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "Collection" },
    { "type": "checkbox", "id": "show_image", "label": "Kollektionsbild als Hintergrund", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Beschreibung zeigen", "default": true },
    { "type": "checkbox", "id": "enable_filtering", "label": "Filter & Sortierung", "default": true, "info": "Filter richtest du in der App „Search & Discovery“ ein (z. B. Größe, Farbe, Preis)." },
    { "type": "range", "id": "per_page", "label": "Produkte pro Seite", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "Spalten (Desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Spalten (Handy)", "default": "2", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }] }
  ]
}
{% endschema %}
