{%- assign s = section.settings -%}
<div class="nl" style="--pt: {{ s.padding_top | divided_by: 100.0 }}; --pb: {{ s.padding_bottom | divided_by: 100.0 }};">
  {%- if s.sky -%}<canvas class="nl__sky" data-sky="full" data-density="40" data-shooting="50" aria-hidden="true"></canvas>{%- endif -%}
  <div class="section page-width page-width--narrow nl__inner">
    {%- if s.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ s.eyebrow | escape }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="h1" data-reveal style="--d:1"><span class="text-chrome is-animated" {% if s.scramble %}data-scramble{% endif %}>{{ s.heading | escape }}</span></h2>{%- endif -%}
    {%- if s.text != blank -%}<div class="rte text-muted" data-reveal style="--d:2">{{ s.text }}</div>{%- endif -%}
    <div class="nl__form" data-reveal style="--d:3">
      {%- assign fid = 'Newsletter-' | append: section.id -%}
      {% render 'newsletter-form', form_id: fid, button: s.button %}
    </div>
  </div>
</div>

{% stylesheet %}
  .nl { position: relative; overflow: hidden; isolation: isolate; border-block: 1px solid var(--c-border); }
  .nl__sky { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .nl__inner { display: grid; justify-items: center; text-align: center; gap: 22px; }
  .nl__form { width: min(520px, 100%); text-align: left; display: grid; gap: 10px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    { "type": "paragraph", "content": "Anmeldungen erscheinen unter Kunden mit Marketing-Zustimmung (Tag „newsletter“)." },
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Be first. Always." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Early Access zu jedem Drop und exklusive Angebote – direkt in dein Postfach.</p>" },
    { "type": "text", "id": "button", "label": "Button-Text", "default": "Join" },
    { "type": "checkbox", "id": "sky", "label": "Sternenhimmel im Hintergrund", "default": true },
    { "type": "checkbox", "id": "scramble", "label": "Text-Scramble auf Überschrift", "default": true },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
