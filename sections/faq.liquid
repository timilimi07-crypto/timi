{%- assign s = section.settings -%}
<div class="section page-width page-width--narrow" style="--pt: {{ s.padding_top | divided_by: 100.0 }}; --pb: {{ s.padding_bottom | divided_by: 100.0 }};">
  <div class="section-head section-head--center">
    <div class="section-head__text">
      {%- if s.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="h2" data-reveal style="--d:1">{{ s.heading | escape }}</h2>{%- endif -%}
    </div>
  </div>
  <div aria-label="{{ 'sections.faq.label' | t }}" role="region">
    {%- for block in section.blocks -%}
      <details class="accordion" data-reveal style="--d: {{ forloop.index0 | at_most: 5 }}" {{ block.shopify_attributes }}{% if forloop.first and s.open_first %} open{% endif %}>
        <summary><span>{{ block.settings.question | escape }}</span>{% render 'icon', name: 'plus' %}</summary>
        <div class="accordion__content rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>
{%- if s.schema_markup and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section-faq",
  "max_blocks": 30,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "Support" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "FAQ" },
    { "type": "checkbox", "id": "open_first", "label": "Erste Frage geöffnet", "default": false },
    { "type": "checkbox", "id": "schema_markup", "label": "FAQ für Google auszeichnen (SEO)", "default": true },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 }
  ],
  "blocks": [
    { "type": "question", "name": "Frage", "settings": [
      { "type": "text", "id": "question", "label": "Frage", "default": "Wie fallen die Größen aus?" },
      { "type": "richtext", "id": "answer", "label": "Antwort", "default": "<p>Unsere Hoodies sind oversized geschnitten. Für einen normalen Fit eine Größe kleiner wählen.</p>" }
    ] }
  ],
  "presets": [{
    "name": "FAQ",
    "blocks": [
      { "type": "question", "settings": { "question": "Wie fallen die Größen aus?", "answer": "<p>Unsere Hoodies sind oversized geschnitten. Für einen normalen Fit eine Größe kleiner wählen. Die genauen Maße findest du in der Größentabelle auf jeder Produktseite.</p>" } },
      { "type": "question", "settings": { "question": "Wie lange dauert der Versand?", "answer": "<p>Innerhalb Deutschlands in der Regel 1–3 Werktage.</p>" } },
      { "type": "question", "settings": { "question": "Kann ich zurückschicken?", "answer": "<p>Ja, du hast 14 Tage Widerrufsrecht. Alle Infos findest du auf der Seite Rückgabe.</p>" } },
      { "type": "question", "settings": { "question": "Wie wasche ich meinen Hoodie?", "answer": "<p>Auf links gedreht bei 30 °C waschen, nicht in den Trockner – so bleibt Form und Print lange schön.</p>" } }
    ]
  }]
}
{% endschema %}
