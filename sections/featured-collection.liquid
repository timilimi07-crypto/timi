{%- liquid
  assign s = section.settings
  assign collection = s.collection
  assign slider_id = 'Slider-' | append: section.id
  assign cols = s.columns
-%}
<div class="section" style="--pt: {{ s.padding_top | divided_by: 100.0 }}; --pb: {{ s.padding_bottom | divided_by: 100.0 }};">
  <div class="page-width">
    <div class="section-head{% if s.align == 'center' %} section-head--center{% endif %}">
      <div class="section-head__text">
        {%- if s.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2" data-reveal style="--d:1"><span {% if s.scramble %}data-scramble{% endif %}>{{ s.heading | escape }}</span></h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte text-muted" data-reveal style="--d:2">{{ s.text }}</div>{%- endif -%}
      </div>
      {%- if s.layout == 'slider' -%}
        <div class="slider-nav" data-reveal>
          <button type="button" data-slider-prev aria-controls="{{ slider_id }}" aria-label="{{ 'general.accessibility.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
          <button type="button" data-slider-next aria-controls="{{ slider_id }}" aria-label="{{ 'general.accessibility.next' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
      {%- elsif s.show_view_all and collection != blank and s.align != 'center' -%}
        {% render 'button', label: s.view_all_label, url: collection.url, style: 'ghost', icon: 'arrow-right' %}
      {%- endif -%}
    </div>

    {%- capture sizes_attr -%}(min-width: 990px) calc((min(100vw, {{ settings.page_width }}px) - 96px) / {{ cols }}), (min-width: 750px) 42vw, {% if s.layout == 'slider' %}72vw{% else %}{{ 100 | divided_by: s.columns_mobile }}vw{% endif %}{%- endcapture -%}
    <div
      {% if s.layout == 'slider' %}id="{{ slider_id }}" class="slider" role="region" aria-roledescription="carousel" aria-label="{{ s.heading | escape }}" tabindex="0"{% else %}class="grid"{% endif %}
      style="--cols: {{ cols }}; --cols-tablet: {{ cols | at_most: 3 }}; --cols-mobile: {{ s.columns_mobile }};"
    >
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: s.products_to_show -%}
          <div>
            {%- assign is_eager = false -%}
            {%- if forloop.index <= 2 and section.index <= 2 -%}{%- assign is_eager = true -%}{%- endif -%}
            {% render 'product-card', product: product, index: forloop.index0, sizes: sizes_attr, eager: is_eager, hide_quick_add: s.hide_quick_add %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="card" data-reveal style="--d: {{ forloop.index0 }}">
            <div class="card__media media--portrait">{{ 'product-apparel-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="card__info"><p class="card__title">{{ 'collections.general.empty' | t }}</p></div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- liquid
      assign show_bottom = false
      if s.show_view_all and collection != blank
        if s.layout == 'slider' or s.align == 'center'
          assign show_bottom = true
        endif
      endif
    -%}
    {%- if show_bottom -%}
      <div class="btn-row" style="justify-content: center; margin-top: 40px;" data-reveal>
        {% render 'button', label: s.view_all_label, url: collection.url, style: 'outline', icon: 'arrow-right' %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Kollektion", "info": "Produkte kommen automatisch aus dieser Kollektion." },
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Latest Drop" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "align", "label": "Ausrichtung Überschrift", "default": "left", "options": [
      { "value": "left", "label": "Links" }, { "value": "center", "label": "Mitte" }
    ] },
    { "type": "select", "id": "layout", "label": "Darstellung", "default": "grid", "options": [
      { "value": "grid", "label": "Grid" }, { "value": "slider", "label": "Slider" }
    ] },
    { "type": "range", "id": "products_to_show", "label": "Anzahl Produkte", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Spalten (Desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Spalten (Handy)", "default": "2", "options": [
      { "value": "1", "label": "1" }, { "value": "2", "label": "2" }
    ] },
    { "type": "checkbox", "id": "hide_quick_add", "label": "Quick-Add in dieser Section ausblenden", "default": false },
    { "type": "checkbox", "id": "show_view_all", "label": "„Alle ansehen“-Button", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Button-Text", "default": "Alle ansehen" },
    { "type": "checkbox", "id": "scramble", "label": "Text-Scramble auf Überschrift", "default": true },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Featured Collection" }]
}
{% endschema %}
