{%- liquid
  assign s = section.settings
  assign date_str = s.launch_date | strip | replace: ' ', 'T'
  assign iso = date_str | append: ':00' | append: s.timezone
-%}
<div class="pw" data-countdown="{{ iso }}">
  <canvas class="pw__sky" data-sky="shooting" data-shooting="70" aria-hidden="true"></canvas>
  <header class="pw__top page-width">
    <span class="pw__logo">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 300 | image_tag: alt: shop.name, loading: 'eager' }}
      {%- else -%}
        {% render 'logo-mark', id: 'pw', animated: true %}
      {%- endif -%}
    </span>
    <button type="button" class="btn btn--ghost" data-open="PasswordModal" aria-controls="PasswordModal" aria-expanded="false">
      <span class="btn__label">{{ 'general.password_page.login_title' | t }}</span>
    </button>
  </header>

  <div class="pw__center page-width">
    {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
    <h1 class="h-display pw__title"><span class="text-chrome is-animated" {% if settings.scramble_enable %}data-scramble{% endif %}>{{ s.heading | escape }}</span></h1>
    {%- if s.text != blank -%}<div class="rte text-muted pw__text">{{ s.text }}</div>{%- elsif shop.password_message != blank -%}<p class="text-muted pw__text">{{ shop.password_message }}</p>{%- endif -%}

    {%- if s.show_countdown -%}
      <div class="drop__timer pw__timer" role="timer" aria-label="{{ 'sections.countdown.label' | t }}">
        <div class="drop__unit"><span class="drop__num" data-cd-days>00</span><span class="drop__label">{{ 'sections.countdown.days' | t }}</span></div>
        <div class="drop__unit"><span class="drop__num" data-cd-hours>00</span><span class="drop__label">{{ 'sections.countdown.hours' | t }}</span></div>
        <div class="drop__unit"><span class="drop__num" data-cd-minutes>00</span><span class="drop__label">{{ 'sections.countdown.minutes' | t }}</span></div>
        <div class="drop__unit"><span class="drop__num" data-cd-seconds>00</span><span class="drop__label">{{ 'sections.countdown.seconds' | t }}</span></div>
      </div>
    {%- endif -%}

    {%- if s.show_signup -%}
      <div class="pw__signup">
        {% render 'newsletter-form', form_id: 'PasswordSignup', button: s.signup_button, tags: 'newsletter,launch' %}
      </div>
    {%- endif -%}
    {% render 'social-icons' %}
  </div>

  <footer class="pw__foot page-width">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <span>{{ 'general.password_page.powered_by' | t }}</span>
  </footer>
</div>

<div class="modal" id="PasswordModal" role="dialog" aria-modal="true" aria-labelledby="PasswordModalTitle" aria-hidden="true">
  <div class="modal__backdrop" data-close></div>
  <div class="modal__panel" style="max-width: 460px;">
    <button type="button" class="icon-btn modal__close" data-close aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
    <h2 class="h3" id="PasswordModalTitle" style="margin-bottom: 20px;">{{ 'general.password_page.login_title' | t }}</h2>
    {%- form 'storefront_password', class: 'form-stack' -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        <script>document.addEventListener('DOMContentLoaded',function(){var m=document.getElementById('PasswordModal');if(m&&window.WEAX.openOverlay)window.WEAX.openOverlay(m);});</script>
      {%- endif -%}
      <label class="field"><span class="field__label">{{ 'general.password_page.login_label' | t }}</span>
        <input class="input" type="password" name="password" autocomplete="current-password" required>
      </label>
      <button type="submit" class="btn btn--primary"><span class="btn__label">{{ 'general.password_page.login_button' | t }}</span></button>
      <p class="tax-note">{{ 'general.password_page.admin_link_html' | t: link: '/admin' }}</p>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .pw { position: relative; isolation: isolate; min-height: 100vh; min-height: 100svh; display: grid; grid-template-rows: auto 1fr auto; overflow: hidden; }
  .pw__sky { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .pw__top, .pw__foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 20px; }
  .pw__foot { font-size: var(--fs-xs); color: var(--c-muted); flex-wrap: wrap; }
  .pw__logo img, .pw__logo svg { width: 56px; height: auto; }
  .pw__center { display: grid; justify-items: center; align-content: center; text-align: center; gap: 24px; padding-block: 40px; }
  .pw__title { font-size: clamp(3rem, 12vw, 9rem); }
  .pw__text { max-width: 50ch; }
  .pw__signup { width: min(500px, 100%); text-align: left; display: grid; gap: 10px; }
  .pw__timer .drop__unit { min-width: clamp(64px, 18vw, 130px); }
{% endstylesheet %}

{% schema %}
{
  "name": "Passwort-Seite",
  "tag": "section",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "Coming soon" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Reach for the stars" },
    { "type": "richtext", "id": "text", "label": "Text", "info": "Leer = Nachricht aus Onlineshop → Einstellungen → Passwortschutz.", "default": "<p>Der Shop öffnet bald. Trag dich ein und sei beim ersten Drop dabei.</p>" },
    { "type": "checkbox", "id": "show_countdown", "label": "Countdown zeigen", "default": true },
    { "type": "text", "id": "launch_date", "label": "Launch-Datum & Uhrzeit", "default": "2026-12-12 18:00", "info": "Format: JJJJ-MM-TT HH:MM" },
    { "type": "select", "id": "timezone", "label": "Zeitzone", "default": "+01:00", "options": [
      { "value": "+01:00", "label": "Deutschland Winterzeit (MEZ)" }, { "value": "+02:00", "label": "Deutschland Sommerzeit (MESZ)" }, { "value": "Z", "label": "UTC" }
    ] },
    { "type": "checkbox", "id": "show_signup", "label": "E-Mail-Anmeldung zeigen", "default": true },
    { "type": "text", "id": "signup_button", "label": "Button-Text", "default": "Notify me" }
  ]
}
{% endschema %}
