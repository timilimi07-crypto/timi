{%- assign s = section.settings -%}
<div class="mq-text mq-text--{{ s.style }}" style="--pt: {{ s.padding_top | divided_by: 100.0 }}; --pb: {{ s.padding_bottom | divided_by: 100.0 }}; --rot: {{ s.rotate }}deg; --mq-size: {{ s.size }}; background: {{ s.bg }};">
  {%- capture items -%}
    {%- for block in section.blocks -%}
      <span class="marquee__item" {{ block.shopify_attributes }}>
        <span class="mq-text__word">{{ block.settings.text | escape }}</span>
        {%- render 'icon', name: 'star', class: 'marquee__sep' -%}
      </span>
    {%- endfor -%}
  {%- endcapture -%}
  <div class="mq-text__band" aria-label="{{ section.blocks.first.settings.text | escape }}" role="marquee">
    <div class="marquee{% if s.reverse %} marquee--reverse{% endif %}" style="--speed: {{ s.speed }}s; --gap: clamp(1.5rem, 3vw, 3rem);">
      <div class="marquee__track" aria-hidden="true">{{ items }}{{ items }}</div>
      <div class="marquee__track" aria-hidden="true">{{ items }}{{ items }}</div>
    </div>
    {%- if s.second_row -%}
      <div class="marquee marquee--reverse mq-text__row2" style="--speed: {{ s.speed | times: 1.3 }}s; --gap: clamp(1.5rem, 3vw, 3rem);">
        <div class="marquee__track" aria-hidden="true">{{ items }}{{ items }}</div>
        <div class="marquee__track" aria-hidden="true">{{ items }}{{ items }}</div>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .mq-text { position: relative; overflow: hidden; padding-block: calc(var(--section-gap) * var(--pt) * .5) calc(var(--section-gap) * var(--pb) * .5); }
  .mq-text__band { transform: rotate(var(--rot)); padding-block: clamp(10px, 1.6vw, 20px); border-block: 1px solid var(--c-border-strong); background: rgba(var(--c-bg-rgb), .6); margin-inline: -4vw; }
  .mq-text__word { font-family: var(--font-display); font-weight: 700; line-height: 1; text-transform: var(--h-case); letter-spacing: var(--h-tracking); font-size: calc(clamp(2.6rem, 9vw, 9rem) * var(--mq-size) / 100); }
  .mq-text .marquee__sep { width: clamp(1.2rem, 3vw, 2.6rem); height: auto; filter: drop-shadow(0 0 10px var(--c-glow-solid)); }
  .mq-text--chrome .mq-text__word { background: var(--grad-chrome); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .mq-text--outline .mq-text__word { color: transparent; -webkit-text-stroke: 1px rgba(var(--c-text-rgb), .8); }
  .mq-text--mixed .marquee__item:nth-child(even) .mq-text__word { color: transparent; -webkit-text-stroke: 1px rgba(var(--c-text-rgb), .8); }
  .mq-text--mixed .marquee__item:nth-child(odd) .mq-text__word { background: var(--grad-chrome); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .mq-text__row2 { margin-top: clamp(4px, 1vw, 12px); opacity: .55; }
{% endstylesheet %}

{% schema %}
{
  "name": "Laufschrift (Claim)",
  "tag": "section",
  "class": "section-marquee-text",
  "max_blocks": 10,
  "settings": [
    { "type": "select", "id": "style", "label": "Schrift-Stil", "default": "mixed", "options": [
      { "value": "solid", "label": "Weiß" }, { "value": "chrome", "label": "Chrom" }, { "value": "outline", "label": "Umriss" }, { "value": "mixed", "label": "Chrom + Umriss abwechselnd" }
    ] },
    { "type": "range", "id": "size", "label": "Schriftgröße", "min": 40, "max": 160, "step": 10, "unit": "%", "default": 100 },
    { "type": "range", "id": "speed", "label": "Dauer eines Durchlaufs", "min": 10, "max": 90, "step": 5, "unit": "s", "default": 40 },
    { "type": "checkbox", "id": "reverse", "label": "Andere Richtung", "default": false },
    { "type": "checkbox", "id": "second_row", "label": "Zweite Reihe (gegenläufig)", "default": false },
    { "type": "range", "id": "rotate", "label": "Neigung", "min": -6, "max": 6, "step": 1, "unit": "°", "default": -2 },
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "rgba(0,0,0,0)" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 }
  ],
  "blocks": [
    { "type": "text", "name": "Text", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Reach for the stars" }] }
  ],
  "presets": [{
    "name": "Laufschrift (Claim)",
    "blocks": [
      { "type": "text", "settings": { "text": "Reach for the stars" } },
      { "type": "text", "settings": { "text": "Discipline" } },
      { "type": "text", "settings": { "text": "Take the risk" } }
    ]
  }]
}
{% endschema %}
