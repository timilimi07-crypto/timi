{{ 'product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign fp = s.product
  assign root_id = 'Product-' | append: section.id
-%}
<div class="section page-width" style="--pt: {{ s.padding_top | divided_by: 100.0 }}; --pb: {{ s.padding_bottom | divided_by: 100.0 }};">
  {%- if s.eyebrow != blank or s.heading != blank -%}
    <div class="section-head">
      <div class="section-head__text">
        {%- if s.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2" data-reveal style="--d:1"><span {% if settings.scramble_enable %}data-scramble{% endif %}>{{ s.heading | escape }}</span></h2>{%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if fp != blank -%}
    {%- assign has_chart = false -%}
    {%- if fp.metafields.custom.size_chart != blank or s.size_chart_page != blank -%}{%- assign has_chart = true -%}{%- endif -%}
    <div
      class="product product--media-small"
      id="{{ root_id }}"
      data-product
      data-update-url="false"
      data-low-threshold="{{ settings.badge_low_threshold }}"
      data-t-in="{{ 'products.product.in_stock' | t | escape }}"
      data-t-out="{{ 'products.product.out_of_stock' | t | escape }}"
      data-t-low="{{ 'products.product.low_stock' | t: count: '__COUNT__' | escape }}"
      data-reveal
    >
      <div class="product__media">
        {% render 'product-gallery', product: fp, section_id: section.id, layout: 'slider' %}
      </div>
      <div class="product__info">
        <div class="card__badges" style="position: static; transform: none;">{% render 'product-badges', product: fp %}</div>
        <h3 class="product__title"><a href="{{ fp.url }}" class="text-chrome">{{ fp.title | escape }}</a></h3>
        <div class="product__price">{% render 'price', product: fp, variant: fp.selected_or_first_available_variant, show_note: true %}</div>
        {%- if s.show_description and fp.description != blank -%}
          <div class="rte product__desc">{{ fp.description | strip_html | truncatewords: 40 }}</div>
        {%- endif -%}
        {% render 'variant-picker', product: fp, section_id: section.id, size_chart: has_chart %}
        {% render 'product-form', product: fp, section_id: section.id, show_quantity: s.show_quantity, show_stock: true, show_dynamic_checkout: s.show_dynamic_checkout %}
        <a class="btn btn--ghost" href="{{ fp.url }}" style="justify-self: start;"><span class="btn__label">{{ 'products.product.view_details' | t }}</span>{% render 'icon', name: 'arrow-right' %}</a>
      </div>
    </div>
    {% render 'size-chart', product: fp, section_id: section.id, fallback_page: s.size_chart_page %}
  {%- else -%}
    <div class="product product--media-small">
      <div class="media media--portrait">{{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      <div class="product__info">
        <h3 class="product__title text-chrome">Heavyweight Hoodie</h3>
        <p class="text-muted">Wähle im Editor ein Produkt aus.</p>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Featured Product",
  "tag": "section",
  "class": "section-featured-product",
  "settings": [
    { "type": "product", "id": "product", "label": "Produkt" },
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "Spotlight" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "The Essential" },
    { "type": "checkbox", "id": "show_description", "label": "Kurzbeschreibung zeigen", "default": true },
    { "type": "checkbox", "id": "show_quantity", "label": "Mengenauswahl", "default": false },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Express-Checkout-Buttons", "default": false },
    { "type": "page", "id": "size_chart_page", "label": "Standard-Größentabelle (Seite)" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Featured Product" }]
}
{% endschema %}
