{%- assign s = section.settings -%}
<div class="section page-width" style="--pt: {{ s.padding_top | divided_by: 100.0 }}; --pb: {{ s.padding_bottom | divided_by: 100.0 }};">
  {%- if s.heading != blank or s.eyebrow != blank -%}
    <div class="section-head{% if s.align == 'center' %} section-head--center{% endif %}">
      <div class="section-head__text">
        {%- if s.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2" data-reveal style="--d:1">{{ s.heading | escape }}</h2>{%- endif -%}
      </div>
    </div>
  {%- endif -%}
  <div class="grid multicol" style="--cols: {{ s.columns }}; --cols-tablet: {{ s.columns | at_most: 3 }}; --cols-mobile: {{ s.columns_mobile }};">
    {%- for block in section.blocks -%}
      <div class="multicol__item surface{% if s.align == 'center' %} multicol__item--center{% endif %}" data-reveal style="--d: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <div class="media media--landscape">{% render 'image', image: block.settings.image, sizes: '(min-width: 990px) 25vw, 50vw' %}</div>
        {%- elsif block.settings.icon != 'none' -%}
          <span class="multicol__icon">{% render 'icon', name: block.settings.icon %}</span>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}<h3 class="h4">{{ block.settings.heading | escape }}</h3>{%- endif -%}
        {%- if block.settings.text != blank -%}<div class="rte text-muted">{{ block.settings.text }}</div>{%- endif -%}
        {%- if block.settings.link_label != blank -%}<a class="btn btn--ghost" href="{{ block.settings.link }}"><span class="btn__label">{{ block.settings.link_label | escape }}</span></a>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .multicol__item { display: grid; gap: 14px; align-content: start; padding: clamp(20px, 2.6vw, 32px); transition: border-color .4s, transform .5s var(--ease-out); }
  .multicol__item:hover { border-color: var(--c-border-strong); transform: translateY(-4px); }
  .multicol__item--center { justify-items: center; text-align: center; }
  .multicol__icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; border: 1px solid var(--c-border-strong); box-shadow: 0 0 30px -10px var(--c-glow-solid); }
  .multicol__icon .icon { width: 24px; height: 24px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Mehrspaltig (USPs)",
  "tag": "section",
  "class": "section-multicolumn",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Überzeile" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Why WEAX" },
    { "type": "select", "id": "align", "label": "Ausrichtung", "default": "left", "options": [{ "value": "left", "label": "Links" }, { "value": "center", "label": "Mitte" }] },
    { "type": "range", "id": "columns", "label": "Spalten (Desktop)", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "columns_mobile", "label": "Spalten (Handy)", "default": "1", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }] },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 }
  ],
  "blocks": [
    { "type": "column", "name": "Spalte", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
        { "value": "none", "label": "Keins" }, { "value": "truck", "label": "Versand" }, { "value": "return", "label": "Retoure" }, { "value": "shield", "label": "Qualität/Sicherheit" },
        { "value": "star", "label": "Stern" }, { "value": "sparkle", "label": "Funkeln" }, { "value": "mail", "label": "Mail" }, { "value": "ruler", "label": "Lineal" }
      ] },
      { "type": "image_picker", "id": "image", "label": "Bild (statt Icon)" },
      { "type": "text", "id": "heading", "label": "Überschrift", "default": "Schneller Versand" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Versand in 1–3 Werktagen innerhalb Deutschlands.</p>" },
      { "type": "text", "id": "link_label", "label": "Link-Text" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{
    "name": "Mehrspaltig (USPs)",
    "blocks": [
      { "type": "column", "settings": { "icon": "truck", "heading": "Versand", "text": "<p>Gratis ab 80 €, Lieferung in 1–3 Werktagen.</p>" } },
      { "type": "column", "settings": { "icon": "return", "heading": "Retoure", "text": "<p>14 Tage Widerrufsrecht – unkompliziert zurücksenden.</p>" } },
      { "type": "column", "settings": { "icon": "shield", "heading": "Qualität", "text": "<p>380 gsm Heavyweight, 84 % Baumwolle / 16 % Polyester.</p>" } }
    ]
  }]
}
{% endschema %}
