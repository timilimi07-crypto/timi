{%- comment -%}
  Produktempfehlungen: „Complete the Look“ (passende Teile) oder „Ähnliche Produkte“.
  Reihenfolge: 1. Metafeld custom.complete_the_look (Liste von Produkten, nur bei „Complete the Look“)
               2. Shopify-Empfehlungen (Search & Discovery App), per AJAX nachgeladen
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign manual = nil
  if s.intent == 'complementary' and product.metafields.custom.complete_the_look != blank
    assign manual = product.metafields.custom.complete_the_look.value
  endif
-%}
<div
  class="section page-width"
  style="--pt: {{ s.padding_top | divided_by: 100.0 }}; --pb: {{ s.padding_bottom | divided_by: 100.0 }};"
  {% if manual == nil and recommendations.performed != true %}
    data-recommendations="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.limit }}&intent={{ s.intent }}"
  {% endif %}
>
  {%- liquid
    assign recs = nil
    if manual != nil
      assign recs = manual
    elsif recommendations.performed and recommendations.products_count > 0
      assign recs = recommendations.products
    endif
  -%}
  {%- if recs != nil and recs.size > 0 -%}
    <div class="section-head">
      <div class="section-head__text">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="h2"><span {% if settings.scramble_enable %}data-scramble{% endif %}>{{ s.heading | escape }}</span></h2>
      </div>
    </div>
    <div class="grid" style="--cols: {{ s.columns }}; --cols-tablet: 3; --cols-mobile: 2;">
      {%- for rec in recs limit: s.limit -%}
        <div>{% render 'product-card', product: rec, index: forloop.index0 %}</div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Produktempfehlungen",
  "tag": "section",
  "class": "section-recommendations",
  "settings": [
    { "type": "paragraph", "content": "Empfehlungen kommen automatisch von Shopify. Für „Complete the Look“ kannst du pro Produkt eigene Teile im Metafeld „Complete the Look“ auswählen, oder in der App „Search & Discovery“ ergänzende Produkte festlegen." },
    { "type": "select", "id": "intent", "label": "Art", "default": "related", "options": [
      { "value": "complementary", "label": "Complete the Look (ergänzende Teile)" },
      { "value": "related", "label": "Ähnliche Produkte" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "More" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Das könnte dir gefallen" },
    { "type": "range", "id": "limit", "label": "Anzahl Produkte", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Spalten (Desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Produktempfehlungen" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
