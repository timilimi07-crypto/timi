<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    <style>
      {{ settings.type_heading_font | font_face: font_display: 'swap' }}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      :root {
        --c-bg: {{ settings.color_bg }}; --c-bg-2: {{ settings.color_bg_2 }}; --c-text: {{ settings.color_text }};
        --c-a1: {{ settings.color_accent_1 }}; --c-a2: {{ settings.color_accent_2 }}; --c-a3: {{ settings.color_accent_3 }};
        --f-head: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }}; --f-head-w: {{ settings.type_heading_font.weight }};
        --f-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }}; --f-body-w: {{ settings.type_body_font.weight }};
        --radius: {{ settings.radius }}px;
      }
    </style>
    {{ 'abi.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'abi.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
  </head>
  <body class="abi">
    <canvas class="fx-stars" id="fx-stars" aria-hidden="true"></canvas>
    <div class="fx-blobs" aria-hidden="true"><span></span><span></span><span></span></div>
    <main id="MainContent">{{ content_for_layout }}</main>
    <canvas class="fx-confetti" id="fx-confetti" aria-hidden="true"></canvas>
    <script>window.abi = { fx: { stars: true, sparkles: true, confetti: true, tilt: true }, colors: [{{ settings.color_accent_1 | json }}, {{ settings.color_accent_2 | json }}, {{ settings.color_accent_3 | json }}, '#ffffff'], routes: {}, text: {} };</script>
  </body>
</html>
