<section class="section hero hero--password">
  <div class="container container--narrow center hero__inner">
    <p class="hero__kicker"><span class="pulse-dot"></span>Coming soon</p>
    <h1 class="hero__title" data-split><span class="hero__title-main">{{ shop.name }}</span></h1>
    {%- if shop.password_message != blank -%}<p class="hero__slogan">{{ shop.password_message }}</p>{%- endif -%}
    <div class="glass form-card">
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="buy__error">Falsches Passwort 🙈</p>{%- endif -%}
        <label class="field"><span>Passwort</span><input type="password" name="password" autocomplete="current-password" required></label>
        <button class="btn btn--glow" type="submit">Rein da 🚀</button>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Passwortseite", "settings": [] }
{% endschema %}
