<section class="section page" {{ section.shopify_attributes }}>
  <div class="container container--narrow">
    <header class="section__head reveal">
      <p class="eyebrow">Schreib uns</p>
      <h1 class="section__title glow-text">{{ page.title }}</h1>
    </header>
    {%- if page.content != blank -%}<div class="rte page__content glass">{{ page.content }}</div>{%- endif -%}

    <div class="glass form-card">
      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="success">✅ Danke! Deine Nachricht ist bei uns angekommen. Wir melden uns so schnell wie möglich.</p>
        {%- elsif form.errors -%}
          <p class="buy__error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="fields">
          <label class="field"><span>Name</span><input type="text" name="contact[Name]" autocomplete="name" value="{{ form.name }}"></label>
          <label class="field"><span>E-Mail *</span><input type="email" name="contact[email]" required autocomplete="email" value="{{ form.email }}"></label>
          <label class="field"><span>Bestellnummer (falls vorhanden)</span><input type="text" name="contact[Bestellnummer]"></label>
          <label class="field"><span>Nachricht *</span><textarea name="contact[body]" rows="5" required>{{ form.body }}</textarea></label>
        </div>
        <p class="cart__small">Mit dem Absenden verarbeiten wir deine Angaben zur Beantwortung deiner Anfrage. Mehr in der <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Datenschutzerklärung</a>.</p>
        <button type="submit" class="btn btn--glow" data-magnetic>Absenden 📨</button>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Kontaktformular", "settings": [] }
{% endschema %}
