{%- if section.settings.text != blank -%}
  <div class="announce" {{ section.shopify_attributes }}>
    <div class="announce__track">
      {%- for i in (1..6) -%}
        <span class="announce__item" {% if i > 1 %}aria-hidden="true"{% endif %}>
          {%- if section.settings.link != blank -%}
            <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
          {%- else -%}
            {{ section.settings.text }}
          {%- endif -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Laufband oben",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "🎓 Abi 2027 · Merch & Kuchen jetzt vorbestellen · Bezahlung sicher per PayPal 💸" },
    { "type": "url", "id": "link", "label": "Link (optional)" }
  ]
}
{% endschema %}
