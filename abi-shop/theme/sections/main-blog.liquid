<section class="section">
  <div class="container">
    <header class="section__head reveal"><h1 class="section__title glow-text">{{ blog.title }}</h1></header>
    {%- paginate blog.articles by 12 -%}
      <div class="grid grid--3">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="card reveal" data-tilt>
            <div class="card__media">
              {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'card__img card__img--1' }}{%- else -%}<div class="card__placeholder" aria-hidden="true">📰</div>{%- endif -%}
            </div>
            <div class="card__body"><h2 class="card__title">{{ article.title }}</h2><p class="price">{{ article.published_at | date: '%d.%m.%Y' }}</p></div>
          </a>
        {%- endfor -%}
      </div>
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
