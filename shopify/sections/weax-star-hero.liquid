{%- comment -%}
  WEAX Star Hero – Startseite mit Intro.
  Eine Sternschnuppe fliegt in einem geschwungenen Bogen ins Bild, explodiert in der Mitte
  zum WEAX-Stern mit Orbit-Ring, danach erscheinen Titel, Text und Button.
  Ihr Schweif bleibt als silberne WEAX LINE stehen. Im Hintergrund: funkelnde Sterne,
  Parallax beim Bewegen der Maus und ab und zu kleine Sternschnuppen.
  Datei: sections/weax-star-hero.liquid
{%- endcomment -%}

{%- assign sid = section.id -%}
{% render 'weax-fonts' %}

<style>
  #wsh-{{ sid }} {
    --bg: {{ section.settings.bg_color }};
    --chrome: {{ section.settings.chrome_color }};
    position: relative; overflow: hidden; isolation: isolate;
    min-height: {% if section.settings.height == 'full' %}100svh{% else %}80svh{% endif %};
    display: grid; place-items: center;
    padding: 96px 20px 120px;
    background: radial-gradient(ellipse at 50% 38%, color-mix(in srgb, var(--chrome) 9%, var(--bg)), var(--bg) 62%);
    color: var(--chrome); text-align: center;
  }
  #wsh-{{ sid }} .wsh__canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  #wsh-{{ sid }} .wsh__flash {
    position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: 0;
    background: radial-gradient(circle at var(--fx, 50%) var(--fy, 40%), rgba(255,255,255,.85), rgba(255,255,255,0) 45%);
  }
  #wsh-{{ sid }}.is-arrived .wsh__flash { animation: wsh-flash-{{ sid }} 1.1s ease-out forwards; }

  #wsh-{{ sid }} .wsh__content { position: relative; z-index: 2; display: grid; justify-items: center; gap: 0; max-width: 900px; }
  #wsh-{{ sid }} .wsh__anchor { width: 120px; height: clamp(110px, 18vw, 170px); }
  #wsh-{{ sid }} .wsh__eyebrow { font-size: 12px; letter-spacing: .45em; text-transform: uppercase; margin: 8px 0 0; opacity: .7; }
  #wsh-{{ sid }} .wsh__title {
    font-family: 'Cinzel', 'Times New Roman', serif; font-weight: 700;
    font-size: clamp(54px, 14vw, 150px); line-height: 1; letter-spacing: .18em; margin: 14px 0 0 .18em;
  }
  #wsh-{{ sid }} .wsh__title span {
    display: inline-block;
    background: linear-gradient(100deg, #6f757d 0%, #ffffff 18%, #9aa0a8 36%, #ffffff 52%, #7b8189 70%, #ffffff 88%, #6f757d 100%);
    background-size: 300% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: wsh-shine-{{ sid }} 6s linear infinite; animation-delay: calc(var(--i, 0) * -.25s);
  }
  #wsh-{{ sid }} .wsh__logo { width: min(70vw, 420px); height: auto; margin-top: 14px; filter: drop-shadow(0 0 24px color-mix(in srgb, var(--chrome) 45%, transparent)); }
  #wsh-{{ sid }} .wsh__sub { max-width: 520px; margin: 22px auto 0; line-height: 1.7; font-size: 16px; opacity: .8; }
  #wsh-{{ sid }} .wsh__btn {
    display: inline-flex; align-items: center; gap: 12px; margin-top: 36px;
    padding: 18px 42px; border-radius: 99px; text-decoration: none; font-weight: 700; letter-spacing: .2em;
    text-transform: uppercase; font-size: 14px; color: #0b0b0d;
    background: linear-gradient(180deg, #ffffff, #c9cdd3 55%, #eef0f2);
    box-shadow: 0 0 0 1px rgba(255,255,255,.4) inset, 0 10px 40px -10px color-mix(in srgb, var(--chrome) 70%, transparent);
    transition: transform .3s, box-shadow .3s;
  }
  #wsh-{{ sid }} .wsh__btn:hover, #wsh-{{ sid }} .wsh__btn:focus-visible { transform: translateY(-3px) scale(1.03); box-shadow: 0 0 0 1px #fff inset, 0 18px 60px -10px var(--chrome); outline: none; }
  #wsh-{{ sid }} .wsh__btn svg { width: 16px; height: 16px; }

  #wsh-{{ sid }} .wsh__skip {
    position: absolute; right: 18px; bottom: 18px; z-index: 3;
    background: none; border: 1px solid color-mix(in srgb, var(--chrome) 30%, transparent); color: var(--chrome);
    font-size: 11px; letter-spacing: .25em; text-transform: uppercase; padding: 9px 14px; border-radius: 99px; cursor: pointer;
    opacity: .7; transition: opacity .4s;
  }
  #wsh-{{ sid }} .wsh__skip:hover, #wsh-{{ sid }} .wsh__skip:focus-visible { opacity: 1; outline: none; }
  #wsh-{{ sid }}.is-btn .wsh__skip { opacity: 0; pointer-events: none; }

  #wsh-{{ sid }} .wsh__scroll { position: absolute; left: 50%; bottom: 22px; z-index: 2; width: 1px; height: 44px; transform: translateX(-50%); background: color-mix(in srgb, var(--chrome) 25%, transparent); overflow: hidden; }
  #wsh-{{ sid }} .wsh__scroll::after { content: ""; position: absolute; left: 0; top: -40%; width: 1px; height: 40%; background: var(--chrome); animation: wsh-drop-{{ sid }} 2s ease-in-out infinite; }

  /* Intro-Zustände – nur wenn das Script läuft, sonst ist alles direkt sichtbar */
  #wsh-{{ sid }}.js .wsh__eyebrow,
  #wsh-{{ sid }}.js .wsh__sub,
  #wsh-{{ sid }}.js .wsh__btn,
  #wsh-{{ sid }}.js .wsh__scroll { opacity: 0; transform: translateY(18px); transition: opacity 1s ease, transform 1.2s cubic-bezier(.16,1,.3,1); }
  #wsh-{{ sid }}.js .wsh__title { letter-spacing: .55em; transition: letter-spacing 2.2s cubic-bezier(.16,1,.3,1); }
  #wsh-{{ sid }}.js .wsh__title span { opacity: 0; filter: blur(14px); transform: translateY(30px) scale(1.15);
    transition: opacity .9s ease, filter 1.1s ease, transform 1.3s cubic-bezier(.16,1,.3,1); transition-delay: calc(var(--i, 0) * 90ms); }
  #wsh-{{ sid }}.js .wsh__logo { opacity: 0; filter: blur(14px); transform: scale(1.15); transition: opacity 1s ease, filter 1.2s ease, transform 1.4s cubic-bezier(.16,1,.3,1); }

  #wsh-{{ sid }}.is-title .wsh__title { letter-spacing: .18em; }
  #wsh-{{ sid }}.is-title .wsh__title span { opacity: 1; filter: none; transform: none; }
  #wsh-{{ sid }}.is-title .wsh__logo { opacity: 1; filter: drop-shadow(0 0 24px color-mix(in srgb, var(--chrome) 45%, transparent)); transform: none; }
  #wsh-{{ sid }}.is-title .wsh__eyebrow { opacity: .7; transform: none; }
  #wsh-{{ sid }}.is-sub .wsh__sub { opacity: .8; transform: none; }
  #wsh-{{ sid }}.is-btn .wsh__btn { opacity: 1; transform: none; }
  #wsh-{{ sid }}.is-btn .wsh__scroll { opacity: 1; transform: translateX(-50%); }

  @keyframes wsh-flash-{{ sid }} { 0% { opacity: 0; } 12% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes wsh-shine-{{ sid }} { from { background-position: 100% 0; } to { background-position: -200% 0; } }
  @keyframes wsh-drop-{{ sid }} { 0% { top: -40%; } 100% { top: 100%; } }

  @media (prefers-reduced-motion: reduce) {
    #wsh-{{ sid }} *, #wsh-{{ sid }} *::after { animation: none !important; transition: none !important; }
  }
</style>

<section
  id="wsh-{{ sid }}"
  class="wsh"
  data-chrome="{{ section.settings.chrome_color }}"
  data-speed="{{ section.settings.speed }}"
  data-once="{{ section.settings.play_once }}"
>
  <canvas class="wsh__canvas" aria-hidden="true"></canvas>
  <div class="wsh__flash" aria-hidden="true"></div>

  <div class="wsh__content">
    <div class="wsh__anchor" aria-hidden="true"></div>
    {%- if section.settings.eyebrow != blank -%}
      <p class="wsh__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.logo != blank -%}
      <h1 class="wsh__logo-wrap" style="margin:0">
        <img class="wsh__logo" src="{{ section.settings.logo | image_url: width: 900 }}" alt="{{ section.settings.title | escape }}" width="450" height="{{ 450 | divided_by: section.settings.logo.aspect_ratio | round }}">
      </h1>
    {%- else -%}
      <h1 class="wsh__title">{{ section.settings.title }}</h1>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="wsh__sub">{{ section.settings.subtitle }}</p>
    {%- endif -%}
    {%- if section.settings.button_text != blank -%}
      <a class="wsh__btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_text }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    {%- endif -%}
  </div>

  {%- if section.settings.show_skip -%}
    <button type="button" class="wsh__skip">Intro überspringen</button>
  {%- endif -%}
  <div class="wsh__scroll" aria-hidden="true"></div>
</section>

<script>
(function () {
  var root = document.getElementById('wsh-{{ sid }}');
  if (!root || root.dataset.init) return;
  root.dataset.init = '1';
  root.classList.add('js');

  var canvas = root.querySelector('.wsh__canvas');
  var ctx = canvas.getContext('2d');
  var anchor = root.querySelector('.wsh__anchor');
  var title = root.querySelector('.wsh__title');
  var skipBtn = root.querySelector('.wsh__skip');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var speed = parseFloat(root.dataset.speed) || 1;
  var KEY = 'weax-intro-seen';

  // Titel in einzelne Buchstaben zerlegen (für das Einblenden)
  if (title) {
    var txt = title.textContent.trim();
    title.textContent = '';
    title.setAttribute('aria-label', txt);
    txt.split('').forEach(function (ch, i) {
      var s = document.createElement('span');
      s.textContent = ch === ' ' ? ' ' : ch;
      s.style.setProperty('--i', i);
      s.setAttribute('aria-hidden', 'true');
      title.appendChild(s);
    });
  }

  function hexToRgb(hex) {
    hex = (hex || '#dfe3e8').replace('#', '');
    if (hex.length === 3) hex = hex.replace(/(.)/g, '$1$1');
    var n = parseInt(hex, 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }
  var C = hexToRgb(root.dataset.chrome);
  function col(a) { return 'rgba(' + C[0] + ',' + C[1] + ',' + C[2] + ',' + a + ')'; }
  function white(a) { return 'rgba(255,255,255,' + a + ')'; }

  var D = { field: 500 * speed, travel: 2100 * speed, title: 350 * speed, sub: 1300 * speed, btn: 1800 * speed };
  var W = 0, H = 0, DPR = 1, ax = 0, ay = 0, starR = 36, P = [];
  var stars = [], parts = [], meteors = [];
  var T0 = null, last = null, arrivedAt = null, done = false, raf = null, onScreen = true;
  var mx = 0, my = 0, pmx = 0, pmy = 0, nextMeteor = 0, timers = [];

  function bez(t) {
    var u = 1 - t, a = u * u * u, b = 3 * u * u * t, c = 3 * u * t * t, d = t * t * t;
    return [a * P[0][0] + b * P[1][0] + c * P[2][0] + d * P[3][0], a * P[0][1] + b * P[1][1] + c * P[2][1] + d * P[3][1]];
  }
  function easeTravel(u) { return 1 - Math.pow(1 - u, 2.4); }
  function easeBack(x) { var c1 = 1.9, c3 = c1 + 1; return 1 + c3 * Math.pow(x - 1, 3) + c1 * Math.pow(x - 1, 2); }

  function resize() {
    var r = root.getBoundingClientRect();
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = r.width; H = r.height;
    canvas.width = Math.round(W * DPR); canvas.height = Math.round(H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    var a = anchor.getBoundingClientRect();
    ax = a.left - r.left + a.width / 2; ay = a.top - r.top + a.height / 2;
    starR = Math.max(24, Math.min(48, W * 0.045));
    root.style.setProperty('--fx', (ax / W * 100) + '%');
    root.style.setProperty('--fy', (ay / H * 100) + '%');
    // Geschwungene Flugbahn: von oben links, tiefer Bogen nach unten, dann hoch und in die Mitte
    P = [[-0.12 * W, 0.12 * H], [0.2 * W, 1.0 * H], [ax + 0.22 * W, ay - 0.34 * H], [ax, ay]];
    var count = Math.min(340, Math.round(W * H / 4200));
    stars = [];
    for (var i = 0; i < count; i++) {
      stars.push({ x: Math.random() * W, y: Math.random() * H, r: Math.random() * 1.3 + 0.2, d: Math.random() * 0.8 + 0.2, ph: Math.random() * 6.28, sp: Math.random() * 0.002 + 0.0007 });
    }
  }

  function star8(x, y, R, rot, alpha) {
    ctx.save();
    ctx.translate(x, y); ctx.rotate(rot || 0);
    ctx.beginPath();
    for (var i = 0; i < 16; i++) {
      var ang = i * Math.PI / 8 - Math.PI / 2;
      var rr = (i % 2 === 1) ? R * 0.12 : (i % 4 === 0 ? R : R * 0.48);
      var px = Math.cos(ang) * rr, py = Math.sin(ang) * rr;
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.closePath();
    var g = ctx.createLinearGradient(-R, -R, R, R);
    g.addColorStop(0, '#ffffff'); g.addColorStop(0.45, col(1)); g.addColorStop(0.7, '#ffffff'); g.addColorStop(1, col(1));
    ctx.globalAlpha = alpha == null ? 1 : alpha;
    ctx.fillStyle = g; ctx.shadowColor = col(1); ctx.shadowBlur = R * 0.9;
    ctx.fill();
    ctx.restore();
  }

  function glow(x, y, r, a) {
    var g = ctx.createRadialGradient(x, y, 0, x, y, r);
    g.addColorStop(0, white(a)); g.addColorStop(0.25, col(a * 0.5)); g.addColorStop(1, col(0));
    ctx.fillStyle = g; ctx.beginPath(); ctx.arc(x, y, r, 0, 6.2832); ctx.fill();
  }

  function strokePath(t0, t1, alpha, width) {
    var n = 140, p = bez(t0);
    ctx.beginPath(); ctx.moveTo(p[0], p[1]);
    for (var i = 1; i <= n; i++) { p = bez(t0 + (t1 - t0) * i / n); ctx.lineTo(p[0], p[1]); }
    ctx.strokeStyle = col(alpha); ctx.lineWidth = width; ctx.stroke();
  }

  function drawStars(now, fade) {
    for (var i = 0; i < stars.length; i++) {
      var s = stars[i];
      var a = (0.35 + 0.65 * (0.5 + 0.5 * Math.sin(now * s.sp + s.ph))) * fade * s.d;
      var x = s.x + pmx * 18 * s.d, y = s.y + pmy * 18 * s.d;
      ctx.fillStyle = white(a);
      ctx.fillRect(x, y, s.r, s.r);
      if (s.r > 1.25 && a > 0.6) { ctx.fillStyle = white(a * 0.25); ctx.fillRect(x - 2, y + s.r / 2 - 0.25, 4 + s.r, 0.5); ctx.fillRect(x + s.r / 2 - 0.25, y - 2, 0.5, 4 + s.r); }
    }
  }

  function drawTrail(t, now) {
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    ctx.lineCap = 'round';
    strokePath(0, t, 0.16, 1.2);                       // die Linie, die stehen bleibt
    var L = 0.26, n = 40, t0 = Math.max(0, t - L), prev = bez(t0);
    for (var i = 1; i <= n; i++) {
      var k = i / n, p = bez(t0 + (t - t0) * k);
      ctx.strokeStyle = k > 0.85 ? white(0.9 * k) : col(0.04 + 0.8 * k * k);
      ctx.lineWidth = 0.4 + 4.2 * k * k;
      ctx.beginPath(); ctx.moveTo(prev[0], prev[1]); ctx.lineTo(p[0], p[1]); ctx.stroke();
      prev = p;
    }
    var h = bez(t);
    glow(h[0], h[1], 34, 0.95);
    star8(h[0], h[1], 11, now * 0.006, 1);
    ctx.restore();
    // Funken, die vom Kopf abfallen
    for (var j = 0; j < 3; j++) {
      parts.push({ x: h[0], y: h[1], vx: (Math.random() - 0.5) * 0.9, vy: (Math.random() - 0.3) * 0.9, life: 0, max: 600 + Math.random() * 700, r: Math.random() * 1.6 + 0.4 });
    }
  }

  function arrive(now, quiet) {
    if (arrivedAt !== null) return;
    arrivedAt = now;
    if (!quiet) {
      for (var i = 0; i < 170; i++) {
        var ang = Math.random() * 6.2832, sp = Math.random() * 6 + 1;
        parts.push({ x: ax, y: ay, vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp, life: 0, max: 900 + Math.random() * 1300, r: Math.random() * 1.9 + 0.4 });
      }
      root.classList.add('is-arrived');
      timers.push(setTimeout(function () { root.classList.add('is-title'); }, D.title));
      timers.push(setTimeout(function () { root.classList.add('is-sub'); }, D.sub));
      timers.push(setTimeout(function () { root.classList.add('is-btn'); }, D.btn));
    } else {
      root.classList.add('is-title', 'is-sub', 'is-btn');
    }
    try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
  }

  function drawAfter(now) {
    var k = now - arrivedAt;
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    ctx.lineCap = 'round';

    // WEAX LINE: der Schweif bleibt stehen, ein Lichtpunkt läuft darüber
    strokePath(0, 1, 0.2, 1.2);
    var s = (now / (3200 * speed)) % 1;
    strokePath(Math.max(0, s - 0.07), s, 0.75, 1.8);
    var sp = bez(s); glow(sp[0], sp[1], 10, 0.6);

    // Druckwelle + Lichtstreifen
    if (k < 1000) {
      var q = k / 1000;
      ctx.strokeStyle = white(0.55 * (1 - q)); ctx.lineWidth = 2 * (1 - q) + 0.5;
      ctx.beginPath(); ctx.arc(ax, ay, starR + q * Math.max(W, H) * 0.45, 0, 6.2832); ctx.stroke();
    }
    if (k < 1600) {
      var f = 1 - k / 1600;
      var lg = ctx.createLinearGradient(0, ay, W, ay);
      lg.addColorStop(0, col(0)); lg.addColorStop(0.5, white(0.8 * f)); lg.addColorStop(1, col(0));
      ctx.fillStyle = lg; ctx.fillRect(0, ay - 1.2, W, 2.4);
      glow(ax, ay, starR * 5 * (0.6 + f), 0.5 * f);
    }

    // Orbit-Ring wie im Logo – hintere Hälfte hinter dem Stern
    var g = Math.min(1, k / 1200), og = g < 1 ? easeBack(g) : 1;
    var rx = starR * 2.7 * og, ry = rx * 0.3, rot = -0.38;
    var spin = now * 0.0012;
    if (rx > 1) {
      ctx.lineWidth = 1.3;
      ctx.strokeStyle = col(0.28);
      ctx.beginPath(); ctx.ellipse(ax, ay, rx, ry, rot, Math.PI, 2 * Math.PI); ctx.stroke();
    }

    // Stern
    var sc = k < 650 ? easeBack(k / 650) : 1 + 0.035 * Math.sin(now / 650);
    glow(ax, ay, starR * 3.2, 0.32 + 0.08 * Math.sin(now / 900));
    star8(ax, ay, starR * sc, 0.12 * Math.sin(now / 2400), 1);
    // kurzes Funkeln an den Spitzen
    var tw = 0.5 + 0.5 * Math.sin(now / 420);
    ctx.fillStyle = white(0.5 * tw);
    ctx.fillRect(ax - starR * 1.6, ay - 0.5, starR * 3.2, 1);
    ctx.fillRect(ax - 0.5, ay - starR * 1.6, 1, starR * 3.2);

    // vordere Hälfte des Orbits + Lichtpunkt, der darauf kreist
    if (rx > 1) {
      ctx.strokeStyle = col(0.6); ctx.lineWidth = 1.4;
      ctx.beginPath(); ctx.ellipse(ax, ay, rx, ry, rot, 0, Math.PI); ctx.stroke();
      var oa = spin % 6.2832;
      var ox = ax + Math.cos(oa) * rx * Math.cos(rot) - Math.sin(oa) * ry * Math.sin(rot);
      var oy = ay + Math.cos(oa) * rx * Math.sin(rot) + Math.sin(oa) * ry * Math.cos(rot);
      glow(ox, oy, 9, Math.sin(oa) > 0 ? 0.9 : 0.35);
    }
    ctx.restore();
  }

  function drawMeteors(now, dt) {
    if (arrivedAt !== null && now > nextMeteor) {
      var fromRight = Math.random() < 0.5;
      meteors.push({ x: fromRight ? W * (0.5 + Math.random() * 0.6) : W * Math.random() * 0.5, y: -20, vx: (fromRight ? -1 : 1) * (4 + Math.random() * 3), vy: 2.5 + Math.random() * 2, life: 0, max: 900 + Math.random() * 600 });
      nextMeteor = now + 2200 + Math.random() * 3800;
    }
    ctx.save(); ctx.globalCompositeOperation = 'lighter'; ctx.lineCap = 'round';
    for (var i = meteors.length - 1; i >= 0; i--) {
      var m = meteors[i];
      m.life += dt; m.x += m.vx * dt / 16; m.y += m.vy * dt / 16; m.vy += 0.02 * dt / 16;
      var a = Math.sin(Math.min(1, m.life / m.max) * Math.PI);
      var lg = ctx.createLinearGradient(m.x, m.y, m.x - m.vx * 14, m.y - m.vy * 14);
      lg.addColorStop(0, white(0.9 * a)); lg.addColorStop(1, col(0));
      ctx.strokeStyle = lg; ctx.lineWidth = 1.4;
      ctx.beginPath(); ctx.moveTo(m.x, m.y); ctx.lineTo(m.x - m.vx * 14, m.y - m.vy * 14); ctx.stroke();
      if (m.life > m.max) meteors.splice(i, 1);
    }
    ctx.restore();
  }

  function drawParts(dt) {
    ctx.save(); ctx.globalCompositeOperation = 'lighter';
    for (var i = parts.length - 1; i >= 0; i--) {
      var p = parts[i];
      p.life += dt;
      var f = dt / 16;
      p.vx *= Math.pow(0.955, f); p.vy *= Math.pow(0.955, f); p.vy += 0.015 * f;
      p.x += p.vx * f; p.y += p.vy * f;
      var a = 1 - p.life / p.max;
      if (a <= 0) { parts.splice(i, 1); continue; }
      a *= 0.6 + 0.4 * Math.sin(p.life * 0.03);
      ctx.fillStyle = Math.random() < 0.15 ? white(a) : col(a);
      ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, 6.2832); ctx.fill();
    }
    if (parts.length > 900) parts.splice(0, parts.length - 900);
    ctx.restore();
  }

  function render(now, dt) {
    pmx += (mx - pmx) * 0.05; pmy += (my - pmy) * 0.05;
    ctx.clearRect(0, 0, W, H);
    var el = now - T0;
    drawStars(now, done ? 1 : Math.min(1, el / D.field));
    drawMeteors(now, dt);
    if (arrivedAt === null) {
      var u = Math.max(0, (el - D.field * 0.6) / D.travel);
      if (u < 1) drawTrail(easeTravel(u), now);
      else arrive(now, false);
    }
    if (arrivedAt !== null) drawAfter(now);
    drawParts(dt);
  }

  function frame(now) {
    raf = null;
    if (T0 === null) T0 = now;
    var dt = last === null ? 16 : Math.min(50, now - last);
    last = now;
    render(now, dt);
    if (onScreen && !reduce) raf = requestAnimationFrame(frame);
  }

  function start() { if (!raf && onScreen && !reduce) { last = null; raf = requestAnimationFrame(frame); } }

  function finish() {
    if (arrivedAt !== null) { root.classList.add('is-title', 'is-sub', 'is-btn'); return; }
    done = true;
    arrive(performance.now() - 5000, true);
  }

  function replay() {
    timers.forEach(clearTimeout); timers = [];
    root.classList.remove('is-arrived', 'is-title', 'is-sub', 'is-btn');
    void root.offsetWidth;
    T0 = null; arrivedAt = null; done = false; parts = []; meteors = [];
    start();
  }
  root.weaxReplay = replay;

  resize();

  var seen = false;
  try { seen = root.dataset.once === 'true' && sessionStorage.getItem(KEY) === '1'; } catch (e) {}
  if (window.Shopify && window.Shopify.designMode) seen = false;

  if (reduce) {
    done = true; T0 = 0; arrive(-1e7, true);
    render(1e6, 16);
  } else {
    if (seen) { done = true; arrive(-1e7, true); }
    start();
  }

  if (skipBtn) skipBtn.addEventListener('click', finish);
  root.addEventListener('pointermove', function (e) {
    var r = root.getBoundingClientRect();
    mx = (e.clientX - r.left) / r.width - 0.5; my = (e.clientY - r.top) / r.height - 0.5;
  });

  var rt;
  window.addEventListener('resize', function () {
    clearTimeout(rt);
    rt = setTimeout(function () { resize(); if (reduce) render(1e6, 16); }, 150);
  });

  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      onScreen = entries[0].isIntersecting;
      if (onScreen) start();
    }).observe(root);
  }
})();
</script>

