{%- comment -%}
  WEAX Produkt-Story – Chrome-/Sternen-Look passend zum Star Hero.
  Wird unter den Produktinfos eingesetzt (z. B. Vorlage "origin-pullover").
  Datei: sections/weax-product-story.liquid
{%- endcomment -%}

{%- assign sid = section.id -%}
{% render 'weax-fonts' %}

<style>
  #wps-{{ sid }} {
    --bg: {{ section.settings.bg_color }};
    --chrome: {{ section.settings.chrome_color }};
    position: relative; overflow: hidden; isolation: isolate;
    padding: clamp(64px, 10vw, 120px) 20px;
    background: radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--chrome) 12%, var(--bg)), var(--bg) 65%);
    color: var(--chrome);
  }
  #wps-{{ sid }} .wps__stars {
    position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: .5;
    background-image:
      radial-gradient(1px 1px at 12% 22%, #fff, transparent),
      radial-gradient(1px 1px at 78% 14%, #fff, transparent),
      radial-gradient(1.4px 1.4px at 35% 70%, #fff, transparent),
      radial-gradient(1px 1px at 88% 62%, #fff, transparent),
      radial-gradient(1px 1px at 55% 40%, #fff, transparent),
      radial-gradient(1.2px 1.2px at 22% 88%, #fff, transparent),
      radial-gradient(1px 1px at 66% 90%, #fff, transparent);
  }
  #wps-{{ sid }} .wps__inner { max-width: 1100px; margin: 0 auto; text-align: center; }

  #wps-{{ sid }} .wps__eyebrow { font-size: 12px; letter-spacing: .4em; text-transform: uppercase; opacity: .6; margin: 0; }
  #wps-{{ sid }} .wps__title {
    font-family: 'Cinzel', 'Times New Roman', serif; font-weight: 700;
    font-size: clamp(30px, 6vw, 72px); letter-spacing: .18em; line-height: 1.1; margin: 16px 0 0;
    background: linear-gradient(100deg, #6f757d 0%, #fff 25%, #9aa0a8 45%, #fff 60%, #7b8189 100%);
    background-size: 250% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: wps-shine-{{ sid }} 6s linear infinite;
  }
  #wps-{{ sid }} .wps__text { max-width: 620px; margin: 22px auto 0; line-height: 1.7; opacity: .8; }

  #wps-{{ sid }} .wps__grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1px; margin-top: 56px; background: color-mix(in srgb, var(--chrome) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--chrome) 18%, transparent);
  }
  #wps-{{ sid }} .wps__item { background: var(--bg); padding: 32px 24px; text-align: left; }
  #wps-{{ sid }} .wps__star { width: 22px; height: 22px; display: block; margin-bottom: 18px; }
  #wps-{{ sid }} .wps__item h3 {
    font-family: 'Cinzel', 'Times New Roman', serif; font-weight: 500;
    font-size: 16px; letter-spacing: .2em; text-transform: uppercase; margin: 0; color: #fff;
  }
  #wps-{{ sid }} .wps__item p { margin: 10px 0 0; line-height: 1.6; opacity: .7; font-size: 15px; }

  #wps-{{ sid }} .wps__btn {
    display: inline-flex; align-items: center; gap: 12px; margin-top: 52px;
    padding: 18px 42px; border-radius: 99px; text-decoration: none; font-weight: 700; letter-spacing: .2em;
    text-transform: uppercase; font-size: 14px; color: #0b0b0d;
    background: linear-gradient(180deg, #ffffff, #c9cdd3 55%, #eef0f2);
    box-shadow: 0 0 0 1px rgba(255,255,255,.4) inset, 0 10px 40px -10px color-mix(in srgb, var(--chrome) 70%, transparent);
    transition: transform .3s, box-shadow .3s;
  }
  #wps-{{ sid }} .wps__btn:hover { transform: translateY(-3px) scale(1.03); box-shadow: 0 0 0 1px #fff inset, 0 18px 60px -10px var(--chrome); }

  #wps-{{ sid }} .wps__reveal { opacity: 0; transform: translateY(24px); transition: opacity .9s ease, transform .9s cubic-bezier(.16,1,.3,1); }
  #wps-{{ sid }} .wps__reveal.is-in { opacity: 1; transform: none; }

  @keyframes wps-shine-{{ sid }} { from { background-position: 100% 0; } to { background-position: -150% 0; } }
  @media (prefers-reduced-motion: reduce) {
    #wps-{{ sid }} * { animation: none !important; transition: none !important; }
    #wps-{{ sid }} .wps__reveal { opacity: 1; transform: none; }
  }
</style>

<section id="wps-{{ sid }}">
  <div class="wps__stars" aria-hidden="true"></div>
  <div class="wps__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="wps__eyebrow wps__reveal">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="wps__title wps__reveal">{{ section.settings.heading | default: product.title }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="wps__text wps__reveal">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="wps__grid">
        {%- for block in section.blocks -%}
          <div class="wps__item wps__reveal" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 90 }}ms">
            <svg class="wps__star" viewBox="0 0 40 40" aria-hidden="true">
              <defs>
                <linearGradient id="wps-g-{{ block.id }}" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#fff"/><stop offset=".5" stop-color="#9aa0a8"/><stop offset="1" stop-color="#fff"/>
                </linearGradient>
              </defs>
              <path fill="url(#wps-g-{{ block.id }})" d="M20 0 L23 17 L40 20 L23 23 L20 40 L17 23 L0 20 L17 17 Z"/>
            </svg>
            <h3>{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_text != blank -%}
      <div class="wps__reveal">
        <a class="wps__btn" href="{{ section.settings.button_link | default: '#MainContent' }}">
          {{ section.settings.button_text }} <span aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('wps-{{ sid }}');
    if (!root) return;
    var els = root.querySelectorAll('.wps__reveal');
    if (!('IntersectionObserver' in window)) { els.forEach(function (el) { el.classList.add('is-in'); }); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { threshold: .15 });
    els.forEach(function (el) { io.observe(el); });
  })();
</script>

{% schema %}
{
  "name": "WEAX Produkt-Story",
  "tag": "div",
  "class": "section-weax-product-story",
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "Drop 01" },
    { "type": "text", "id": "heading", "label": "Überschrift", "info": "Leer lassen = Produkttitel", "default": "Origin" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Das Stück, mit dem alles anfängt. Schwerer Stoff, klarer Schnitt, WEAX-Stern auf der Brust.</p>" },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_text", "label": "Button-Text", "default": "Jetzt sichern" },
    { "type": "url", "id": "button_link", "label": "Button-Link", "info": "Leer lassen = zurück nach oben zum Kaufen" },

    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "bg_color", "label": "Hintergrund", "default": "#050507" },
    { "type": "color", "id": "chrome_color", "label": "Chrome / Glow", "default": "#dfe3e8" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Merkmal",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Merkmal" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "WEAX Produkt-Story",
      "blocks": [
        { "type": "feature", "settings": { "title": "Material", "text": "Schweres Fleece, innen angeraut. Weich, warm und formstabil." } },
        { "type": "feature", "settings": { "title": "Schnitt", "text": "Leicht oversized mit tiefer Schulter. Fällt sauber, ohne aufzutragen." } },
        { "type": "feature", "settings": { "title": "Details", "text": "Dezentes WEAX-Branding, Rippbündchen an Ärmeln und Saum." } },
        { "type": "feature", "settings": { "title": "Pflege", "text": "Auf links bei 30 °C waschen. Nicht in den Trockner." } }
      ]
    }
  ]
}
{% endschema %}
