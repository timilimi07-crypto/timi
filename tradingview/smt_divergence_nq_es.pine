//@version=6
// SMT Divergence – NQ sweept, ES nicht
// Auf den NQ-Chart legen. Markiert nur die Swing-Highs und Swing-Lows,
// die NQ sweept, während ES sein entsprechendes Hoch/Tief NICHT nimmt.
//
//  Bearish SMT: NQ nimmt ein Swing-High, ES bleibt unter seinem Hoch.
//  Bullish SMT: NQ nimmt ein Swing-Low,  ES bleibt über seinem Tief.
//
// Nimmt ES sein Level zuerst oder auf derselben Kerze, ist das Level erledigt
// und wird nicht markiert.
indicator("SMT Divergence NQ/ES", "SMT", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ───────────────────────── Inputs ─────────────────────────
grpS     = "Vergleichssymbol"
compSym  = input.symbol("CME_MINI:ES1!", "Vergleich (ES)", group = grpS, tooltip = "Für Micros: CME_MINI:MES1!")

grpP      = "Swings"
leftLen   = input.int(5, "Pivot links", minval = 1, group = grpP)
rightLen  = input.int(3, "Pivot rechts", minval = 1, group = grpP, tooltip = "Anzahl Kerzen zur Bestätigung eines Swings.")
tol       = input.int(1, "Toleranz (Kerzen)", minval = 0, maxval = 10, group = grpP, tooltip = "ES darf sein Hoch/Tief bis zu so vielen Kerzen vor dem NQ-Swing gemacht haben.")
maxAge    = input.int(100, "Max. Alter eines Swings (Kerzen)", minval = 5, group = grpP)
maxSwings = input.int(10, "Max. offene Swings je Seite", minval = 1, maxval = 50, group = grpP)

grpM      = "Anzeige"
showHigh  = input.bool(true, "Highs (bearish SMT)", group = grpM)
showLow   = input.bool(true, "Lows (bullish SMT)", group = grpM)
showSwing = input.bool(false, "Swing-Punkte markieren", group = grpM)

grpC     = "Stil"
bearCol  = input.color(#F23645, "Bearish", group = grpC)
bullCol  = input.color(#089981, "Bullish", group = grpC)
lw       = input.int(2, "Linienstärke", minval = 1, maxval = 4, group = grpC)
lblSize  = input.string("Klein", "Label-Größe", options = ["Winzig", "Klein", "Normal"], group = grpC)

sz = lblSize == "Winzig" ? size.tiny : lblSize == "Normal" ? size.normal : size.small

// ───────────────────────── Daten ─────────────────────────
parts = str.split(compSym, ":")
cName = array.get(parts, array.size(parts) - 1)
me    = syminfo.ticker

[cH, cL] = request.security(compSym, timeframe.period, [high, low], lookahead = barmerge.lookahead_off)

// Extrem von ES ab "tol" Kerzen vor dem Pivot bis jetzt
f_extreme(series float src, int len, bool isHigh) =>
    float v = na
    for i = 0 to len
        float x = src[i]
        if not na(x)
            v := na(v) ? x : isHigh ? math.max(v, x) : math.min(v, x)
    v

ph  = ta.pivothigh(high, leftLen, rightLen)
pl  = ta.pivotlow(low, leftLen, rightLen)
cHp = f_extreme(cH, rightLen + tol, true)
cLp = f_extreme(cL, rightLen + tol, false)

fmt(float v) => str.tostring(v, format.mintick)

// ───────────────────────── Offene Swings ─────────────────────────
var hLvl = array.new<float>()
var hCmp = array.new<float>()
var hBar = array.new<int>()
var lLvl = array.new<float>()
var lCmp = array.new<float>()
var lBar = array.new<int>()

bool bearSMT = false
bool bullSMT = false

// Highs: NQ sweept, ES nicht
if array.size(hLvl) > 0
    string tip = ""
    for i = array.size(hLvl) - 1 to 0
        float lvl = array.get(hLvl, i)
        float cmp = array.get(hCmp, i)
        int   b   = array.get(hBar, i)
        bool nqSweep = high > lvl
        bool esSweep = not na(cH) and cH > cmp
        if bar_index - b > maxAge or nqSweep or esSweep
            if nqSweep and not esSweep and showHigh
                bearSMT := true
                line.new(b, lvl, bar_index, lvl, color = bearCol, width = lw)
                tip += me + " sweept " + fmt(lvl) + " · " + cName + " nicht (Hoch " + str.tostring(cmp) + ", jetzt " + str.tostring(cH) + ")\n"
            array.remove(hLvl, i)
            array.remove(hCmp, i)
            array.remove(hBar, i)
    if bearSMT
        label.new(bar_index, high, "▼ SMT", yloc = yloc.abovebar, style = label.style_label_down, color = color.new(bearCol, 85), textcolor = bearCol, size = sz, tooltip = "Bearish SMT\n" + tip)

// Lows: NQ sweept, ES nicht
if array.size(lLvl) > 0
    string tip = ""
    for i = array.size(lLvl) - 1 to 0
        float lvl = array.get(lLvl, i)
        float cmp = array.get(lCmp, i)
        int   b   = array.get(lBar, i)
        bool nqSweep = low < lvl
        bool esSweep = not na(cL) and cL < cmp
        if bar_index - b > maxAge or nqSweep or esSweep
            if nqSweep and not esSweep and showLow
                bullSMT := true
                line.new(b, lvl, bar_index, lvl, color = bullCol, width = lw)
                tip += me + " sweept " + fmt(lvl) + " · " + cName + " nicht (Tief " + str.tostring(cmp) + ", jetzt " + str.tostring(cL) + ")\n"
            array.remove(lLvl, i)
            array.remove(lCmp, i)
            array.remove(lBar, i)
    if bullSMT
        label.new(bar_index, low, "▲ SMT", yloc = yloc.belowbar, style = label.style_label_up, color = color.new(bullCol, 85), textcolor = bullCol, size = sz, tooltip = "Bullish SMT\n" + tip)

// Neue Swings registrieren (nach der Prüfung, damit sie erst ab der nächsten Kerze zählen)
if not na(ph) and not na(cHp)
    array.push(hLvl, ph)
    array.push(hCmp, cHp)
    array.push(hBar, bar_index - rightLen)
    if array.size(hLvl) > maxSwings
        array.shift(hLvl)
        array.shift(hCmp)
        array.shift(hBar)

if not na(pl) and not na(cLp)
    array.push(lLvl, pl)
    array.push(lCmp, cLp)
    array.push(lBar, bar_index - rightLen)
    if array.size(lLvl) > maxSwings
        array.shift(lLvl)
        array.shift(lCmp)
        array.shift(lBar)

// ───────────────────────── Swing-Punkte ─────────────────────────
plotshape(showSwing and not na(ph), "Swing High", shape.circle, location.abovebar, color.new(bearCol, 50), offset = -rightLen, size = size.tiny)
plotshape(showSwing and not na(pl), "Swing Low", shape.circle, location.belowbar, color.new(bullCol, 50), offset = -rightLen, size = size.tiny)

// ───────────────────────── Alerts ─────────────────────────
alertcondition(bearSMT, "Bearish SMT", "Bearish SMT: {{ticker}} sweept ein Hoch, ES nicht ({{interval}})")
alertcondition(bullSMT, "Bullish SMT", "Bullish SMT: {{ticker}} sweept ein Tief, ES nicht ({{interval}})")
alertcondition(bearSMT or bullSMT, "Jede SMT", "SMT: {{ticker}} sweept, ES nicht ({{interval}})")
