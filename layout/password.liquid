<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <meta name="robots" content="noindex">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}
    <title>{{ shop.name }} – Coming soon</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    {% render 'meta-tags' %}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
    <script>
      document.documentElement.classList.replace('no-js', 'js');
      window.WEAX = {
        routes: { root: {{ routes.root_url | json }}, cart: {{ routes.cart_url | json }}, cartAdd: {{ routes.cart_add_url | json }}, cartChange: {{ routes.cart_change_url | json }}, cartUpdate: {{ routes.cart_update_url | json }}, search: {{ routes.search_url | json }}, predictiveSearch: {{ routes.predictive_search_url | json }} },
        settings: { cartType: 'page', starfield: {{ settings.starfield_enable | json }}, starDensity: {{ settings.starfield_density | json }}, starSpeed: {{ settings.starfield_speed | json }}, shootingFreq: {{ settings.shooting_frequency | json }}, cursor: {{ settings.cursor_enable | json }}, scramble: {{ settings.scramble_enable | json }}, magnetic: {{ settings.magnetic_enable | json }}, reveal: {{ settings.reveal_enable | json }} },
        strings: {}, designMode: {{ request.design_mode | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'effects.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
  </head>
  <body class="template-password reveal-{{ settings.reveal_style }}{% if settings.reveal_enable %} has-reveal{% endif %}">
    {%- if settings.starfield_enable -%}<canvas class="starfield" id="Starfield" aria-hidden="true"></canvas>{%- endif -%}
    <div class="sky-glow" aria-hidden="true"></div>
    <main id="MainContent" class="main" role="main">
      {{ content_for_layout }}
    </main>
    {%- if settings.grain_enable -%}<div class="grain" aria-hidden="true"></div>{%- endif -%}
    {%- if settings.cursor_enable -%}<div class="cursor" aria-hidden="true"><span class="cursor__dot"></span><span class="cursor__ring"></span></div>{%- endif -%}
    <div class="toast" role="status" aria-live="polite" data-toast></div>
  </body>
</html>
