{%- comment -%} Social-Icons aus den Theme-Einstellungen {%- endcomment -%}
<ul class="social-icons{% if class %} {{ class }}{% endif %}" role="list">
  {%- if settings.social_instagram != blank -%}
    <li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.instagram' | t: shop: shop.name }}">{% render 'icon', name: 'instagram' %}</a></li>
  {%- endif -%}
  {%- if settings.social_tiktok != blank -%}
    <li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.tiktok' | t: shop: shop.name }}">{% render 'icon', name: 'tiktok' %}</a></li>
  {%- endif -%}
  {%- if settings.social_youtube != blank -%}
    <li><a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a></li>
  {%- endif -%}
  {%- if settings.social_pinterest != blank -%}
    <li><a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a></li>
  {%- endif -%}
</ul>
