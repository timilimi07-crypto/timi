{%- comment -%}
  SVG-Icons. Aufruf: {% render 'icon', name: 'cart', class: '' %}
  Verfügbar: menu, close, search, account, cart, arrow-right, arrow-left, chevron-down, plus, minus,
  star, check, truck, return, shield, sparkle, zoom, play, mail, trash, ruler, instagram, tiktok, youtube, pinterest
{%- endcomment -%}
<svg class="icon icon-{{ name }}{% if class %} {{ class }}{% endif %}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {%- case name -%}
    {%- when 'menu' -%}<path d="M3 7h18M3 17h12"/>
    {%- when 'close' -%}<path d="M5 5l14 14M19 5L5 19"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>
    {%- when 'account' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.4-6 8-6s6.5 2 8 6"/>
    {%- when 'cart' -%}<path d="M5 8h14l-1.2 12.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'arrow-right' -%}<path d="M4 12h16M14 6l6 6-6 6"/>
    {%- when 'arrow-left' -%}<path d="M20 12H4M10 6l-6 6 6 6"/>
    {%- when 'chevron-down' -%}<path d="M6 9l6 6 6-6"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'star' -%}<path d="M12 2l2.6 7.4L22 12l-7.4 2.6L12 22l-2.6-7.4L2 12l7.4-2.6z" fill="currentColor" stroke="none"/>
    {%- when 'check' -%}<path d="M4 12.5l5 5L20 6.5"/>
    {%- when 'truck' -%}<path d="M2 6h12v10H2zM14 10h4l4 3v3h-8"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
    {%- when 'return' -%}<path d="M9 14L4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/>
    {%- when 'shield' -%}<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>
    {%- when 'sparkle' -%}<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M18 6l-2.5 2.5M8.5 15.5L6 18"/>
    {%- when 'zoom' -%}<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2M11 8v6M8 11h6"/>
    {%- when 'play' -%}<path d="M7 4l13 8-13 8z" fill="currentColor"/>
    {%- when 'mail' -%}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
    {%- when 'trash' -%}<path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/>
    {%- when 'ruler' -%}<path d="M3 17L17 3l4 4L7 21z"/><path d="M7 13l2 2M10 10l2 2M13 7l2 2"/>
    {%- when 'instagram' -%}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/>
    {%- when 'tiktok' -%}<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.6 2.2 4.4 5 4.6"/>
    {%- when 'youtube' -%}<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9v6l5-3z" fill="currentColor"/>
    {%- when 'pinterest' -%}<circle cx="12" cy="12" r="9"/><path d="M11 8.5c3-1 5.5.5 5 3.5-.5 2.5-3 3.5-4.5 2.5M11.5 10l-2.5 11"/>
  {%- endcase -%}
</svg>
